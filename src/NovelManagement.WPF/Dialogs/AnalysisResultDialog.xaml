<Window x:Class="NovelManagement.WPF.Services.AnalysisResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Loc.AR.WindowTitle}" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">
    
    <Window.Resources>
        <Style x:Key="ScoreTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <materialDesign:Card Grid.Row="0" Margin="20,20,20,10" Padding="20">
            <StackPanel>
                <TextBlock x:Name="SettingNameTextBlock" 
                           Text="{DynamicResource Loc.AR.SettingNamePlaceholder}"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Loc.AR.ReportSubtitle}" 
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </materialDesign:Card>
        
        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" Margin="20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 评分卡片 -->
                <materialDesign:Card Margin="0,10" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 总体评分 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Loc.AR.OverallScore}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <materialDesign:Card Background="{DynamicResource PrimaryHueMidBrush}" 
                                               Width="60" Height="60" Margin="0,10">
                                <TextBlock x:Name="OverallScoreText" 
                                         Text="8.5"
                                         Style="{StaticResource ScoreTextStyle}"
                                         Foreground="White"/>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- 一致性评分 -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Loc.AR.Consistency}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <materialDesign:Card Background="{DynamicResource SecondaryHueMidBrush}" 
                                               Width="60" Height="60" Margin="0,10">
                                <TextBlock x:Name="ConsistencyScoreText" 
                                         Text="8.0"
                                         Style="{StaticResource ScoreTextStyle}"
                                         Foreground="White"/>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- 完整性评分 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Loc.AR.Completeness}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <materialDesign:Card Background="{DynamicResource SecondaryHueMidBrush}" 
                                               Width="60" Height="60" Margin="0,10">
                                <TextBlock x:Name="CompletenessScoreText" 
                                         Text="9.0"
                                         Style="{StaticResource ScoreTextStyle}"
                                         Foreground="White"/>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- 逻辑性评分 -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{DynamicResource Loc.AR.Logical}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <materialDesign:Card Background="{DynamicResource SecondaryHueMidBrush}" 
                                               Width="60" Height="60" Margin="0,10">
                                <TextBlock x:Name="LogicalScoreText" 
                                         Text="8.5"
                                         Style="{StaticResource ScoreTextStyle}"
                                         Foreground="White"/>
                            </materialDesign:Card>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
                
                <!-- 详细分析 -->
                <materialDesign:Card Margin="0,10" Padding="20">
                    <StackPanel>
                        <!-- 优势 -->
                        <TextBlock Text="{DynamicResource Loc.AR.StrengthsHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl x:Name="StrengthsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <materialDesign:PackIcon Kind="CheckCircle" 
                                                               Foreground="Green" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- 劣势 -->
                        <TextBlock Text="{DynamicResource Loc.AR.WeaknessesHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl x:Name="WeaknessesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <materialDesign:PackIcon Kind="AlertCircle" 
                                                               Foreground="Orange" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- 建议 -->
                        <TextBlock Text="{DynamicResource Loc.AR.SuggestionsHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl x:Name="SuggestionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <materialDesign:PackIcon Kind="Lightbulb" 
                                                               Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- 冲突 -->
                        <TextBlock x:Name="ConflictsHeader" Text="{DynamicResource Loc.AR.ConflictsHeader}" Style="{StaticResource SectionHeaderStyle}" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ConflictsList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <materialDesign:PackIcon Kind="Fire" 
                                                               Foreground="Red" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- 缺失元素 -->
                        <TextBlock x:Name="MissingHeader" Text="{DynamicResource Loc.AR.MissingHeader}" Style="{StaticResource SectionHeaderStyle}" Visibility="Collapsed"/>
                        <ItemsControl x:Name="MissingElementsList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <materialDesign:PackIcon Kind="FileDocumentMinus" 
                                                               Foreground="Gray" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- 分析时间 -->
                <TextBlock x:Name="AnalysisTimeText" 
                           Text="{DynamicResource Loc.AR.AnalysisTimeSample}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           HorizontalAlignment="Center"
                           Opacity="0.6"
                           Margin="0,10"/>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <Button Content="{DynamicResource Loc.AR.ExportReport}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="10" 
                    Click="ExportReport_Click"/>
            <Button Content="{DynamicResource Loc.Dlg.Close}" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="10" 
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
