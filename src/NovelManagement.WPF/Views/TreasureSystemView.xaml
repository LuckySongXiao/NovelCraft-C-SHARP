<UserControl x:Class="NovelManagement.WPF.Views.TreasureSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryHueMidBrush}" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Diamond" 
                                           Foreground="White" 
                                           Width="32" 
                                           Height="32" 
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Loc.WS.Trea.Title}" 
                             Foreground="White" 
                             FontSize="24" 
                             FontWeight="Medium" 
                             VerticalAlignment="Center" 
                             Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="AddTreasure_Click"
                            ToolTip="{DynamicResource Loc.WS.Trea.NewTooltip}">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="ImportTreasure_Click"
                            ToolTip="{DynamicResource Loc.WS.Trea.ImportTooltip}">
                        <materialDesign:PackIcon Kind="Import" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="ExportTreasure_Click"
                            ToolTip="{DynamicResource Loc.WS.Trea.ExportTooltip}">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="AIAssistant_Click"
                            ToolTip="{DynamicResource Loc.WS.Common.AIAssistant}">
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：灵宝列表 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Padding="16,16,16,8">
                        <TextBox x:Name="SearchTextBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.SearchHint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="SearchTextBox_TextChanged"/>
                    </Border>

                    <!-- 筛选器 -->
                    <Border Grid.Row="1" Padding="16,0,16,8">
                        <StackPanel>
                            <ComboBox x:Name="TreasureTypeFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.TypeHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="TreasureTypeFilter_SelectionChanged"
                                     Margin="0,0,0,8">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllTypes}"/>
                                <ComboBoxItem Tag="武器类" Content="{DynamicResource Loc.WS.Trea.Data.武器类}"/>
                                <ComboBoxItem Tag="防具类" Content="{DynamicResource Loc.WS.Trea.Data.防具类}"/>
                                <ComboBoxItem Tag="饰品类" Content="{DynamicResource Loc.WS.Trea.Data.饰品类}"/>
                                <ComboBoxItem Tag="法器类" Content="{DynamicResource Loc.WS.Trea.Data.法器类}"/>
                                <ComboBoxItem Tag="丹药类" Content="{DynamicResource Loc.WS.Trea.Data.丹药类}"/>
                                <ComboBoxItem Tag="符箓类" Content="{DynamicResource Loc.WS.Trea.Data.符箓类}"/>
                                <ComboBoxItem Tag="阵法类" Content="{DynamicResource Loc.WS.Trea.Data.阵法类}"/>
                                <ComboBoxItem Tag="特殊类" Content="{DynamicResource Loc.WS.Trea.Data.特殊类}"/>
                            </ComboBox>
                            <ComboBox x:Name="GradeFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.GradeHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="GradeFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllGrades}"/>
                                <ComboBoxItem Tag="凡品" Content="{DynamicResource Loc.WS.Trea.Data.凡品}"/>
                                <ComboBoxItem Tag="灵品" Content="{DynamicResource Loc.WS.Trea.Data.灵品}"/>
                                <ComboBoxItem Tag="宝品" Content="{DynamicResource Loc.WS.Trea.Data.宝品}"/>
                                <ComboBoxItem Tag="王品" Content="{DynamicResource Loc.WS.Trea.Data.王品}"/>
                                <ComboBoxItem Tag="皇品" Content="{DynamicResource Loc.WS.Trea.Data.皇品}"/>
                                <ComboBoxItem Tag="帝品" Content="{DynamicResource Loc.WS.Trea.Data.帝品}"/>
                                <ComboBoxItem Tag="圣品" Content="{DynamicResource Loc.WS.Trea.Data.圣品}"/>
                                <ComboBoxItem Tag="神品" Content="{DynamicResource Loc.WS.Trea.Data.神品}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 灵宝列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TreasureListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectTreasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                       Kind="Diamond" 
                                                                       Width="20" 
                                                                       Height="20" 
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>

                                                <Border Grid.Column="2" 
                                                      Background="{DynamicResource PrimaryHueLightBrush}"
                                                      CornerRadius="8"
                                                      Padding="6,2">
                                                    <TextBlock Text="{Binding Grade}" 
                                                             Foreground="White" 
                                                             FontSize="10"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" 
                                                     Text="{Binding Description}" 
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     FontSize="12"
                                                     Margin="28,4,0,0"
                                                     TextWrapping="Wrap"/>

                                            <StackPanel Grid.Row="2" 
                                                      Orientation="Horizontal" 
                                                      Margin="28,4,0,0">
                                                <TextBlock Text="{DynamicResource Loc.WS.Trea.TypeLabelDup}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="{Binding Type}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                                <TextBlock Text="{DynamicResource Loc.WS.Trea.SpiritLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding SpiritLevel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 统计信息 -->
                    <Border Grid.Row="3" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.WS.Trea.Stats}" 
                                     FontWeight="Medium" 
                                     FontSize="12" 
                                     Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Common.TotalLabel}"/>
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.武器类}"/>
                                        <Run Text="{Binding WeaponCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.法器类}"/>
                                        <Run Text="{Binding ArtifactCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.丹药类}"/>
                                        <Run Text="{Binding PillCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 右侧：灵宝详情编辑区域 -->
            <materialDesign:Card Grid.Column="1" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="24">
                        <!-- 默认提示 -->
                        <StackPanel x:Name="EmptyStatePanel" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Visibility="Visible">
                            <materialDesign:PackIcon Kind="DiamondOutline" 
                                                   Width="64" 
                                                   Height="64" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Trea.NoSelection}" 
                                     FontSize="16" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Trea.NoSelectionHint}" 
                                     FontSize="14" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 灵宝详情编辑面板 -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <!-- 基本信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Common.BasicInfo}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="TreasureNameTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.NameHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="TreasureTypeComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.TypeHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="武器类" Content="{DynamicResource Loc.WS.Trea.Data.武器类}"/>
                                    <ComboBoxItem Tag="防具类" Content="{DynamicResource Loc.WS.Trea.Data.防具类}"/>
                                    <ComboBoxItem Tag="饰品类" Content="{DynamicResource Loc.WS.Trea.Data.饰品类}"/>
                                    <ComboBoxItem Tag="法器类" Content="{DynamicResource Loc.WS.Trea.Data.法器类}"/>
                                    <ComboBoxItem Tag="丹药类" Content="{DynamicResource Loc.WS.Trea.Data.丹药类}"/>
                                    <ComboBoxItem Tag="符箓类" Content="{DynamicResource Loc.WS.Trea.Data.符箓类}"/>
                                    <ComboBoxItem Tag="阵法类" Content="{DynamicResource Loc.WS.Trea.Data.阵法类}"/>
                                    <ComboBoxItem Tag="特殊类" Content="{DynamicResource Loc.WS.Trea.Data.特殊类}"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                         x:Name="GradeComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.GradeHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="凡品" Content="{DynamicResource Loc.WS.Trea.Data.凡品}"/>
                                    <ComboBoxItem Tag="灵品" Content="{DynamicResource Loc.WS.Trea.Data.灵品}"/>
                                    <ComboBoxItem Tag="宝品" Content="{DynamicResource Loc.WS.Trea.Data.宝品}"/>
                                    <ComboBoxItem Tag="王品" Content="{DynamicResource Loc.WS.Trea.Data.王品}"/>
                                    <ComboBoxItem Tag="皇品" Content="{DynamicResource Loc.WS.Trea.Data.皇品}"/>
                                    <ComboBoxItem Tag="帝品" Content="{DynamicResource Loc.WS.Trea.Data.帝品}"/>
                                    <ComboBoxItem Tag="圣品" Content="{DynamicResource Loc.WS.Trea.Data.圣品}"/>
                                    <ComboBoxItem Tag="神品" Content="{DynamicResource Loc.WS.Trea.Data.神品}"/>
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                         x:Name="SpiritLevelComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.SpiritLevelHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="无灵性" Content="{DynamicResource Loc.WS.Trea.Data.无灵性}"/>
                                    <ComboBoxItem Tag="微弱灵性" Content="{DynamicResource Loc.WS.Trea.Data.微弱灵性}"/>
                                    <ComboBoxItem Tag="初级灵性" Content="{DynamicResource Loc.WS.Trea.Data.初级灵性}"/>
                                    <ComboBoxItem Tag="中级灵性" Content="{DynamicResource Loc.WS.Trea.Data.中级灵性}"/>
                                    <ComboBoxItem Tag="高级灵性" Content="{DynamicResource Loc.WS.Trea.Data.高级灵性}"/>
                                    <ComboBoxItem Tag="完整灵性" Content="{DynamicResource Loc.WS.Trea.Data.完整灵性}"/>
                                    <ComboBoxItem Tag="超越灵性" Content="{DynamicResource Loc.WS.Trea.Data.超越灵性}"/>
                                </ComboBox>
                            </Grid>

                            <TextBox x:Name="TreasureDescriptionTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.DescHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="3"
                                    MaxLines="5"
                                    Margin="0,0,0,24"/>

                            <!-- 灵宝属性 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Trea.AttrsTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="SpiritPowerTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.SpiritPowerHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="ElementAffinityTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.ElementHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="SpecialAbilityTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.AbilityHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="UsageLimitTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.RestrictionHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <!-- 炼制信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Trea.CraftingTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="CraftingMaterialsTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.MaterialsHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinLines="2"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="CraftingDifficultyComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.DifficultyHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Tag="简单" Content="{DynamicResource Loc.WS.Trea.Data.简单}"/>
                                    <ComboBoxItem Tag="普通" Content="{DynamicResource Loc.WS.Common.Data.普通}"/>
                                    <ComboBoxItem Tag="困难" Content="{DynamicResource Loc.WS.Trea.Data.困难}"/>
                                    <ComboBoxItem Tag="极难" Content="{DynamicResource Loc.WS.Trea.Data.极难}"/>
                                    <ComboBoxItem Tag="传说" Content="{DynamicResource Loc.WS.Trea.Data.传说}"/>
                                </ComboBox>
                            </Grid>

                            <TextBox x:Name="CraftingMethodTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Trea.MethodHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="3"
                                    MaxLines="5"
                                    Margin="0,0,0,24"/>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Right" 
                                      Margin="0,16,0,0">
                                <Button Content="{DynamicResource Loc.Dlg.Save}" 
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Click="SaveTreasure_Click"
                                      Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Loc.Dlg.Cancel}" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Click="CancelEdit_Click"
                                      Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
