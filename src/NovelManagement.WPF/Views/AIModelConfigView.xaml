<UserControl x:Class="NovelManagement.WPF.Views.AIModelConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        
        <Style x:Key="ModelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:Card Grid.Row="0" Margin="20" Padding="20" materialDesign:ShadowAssist.ShadowDepth="Depth2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Cog" Width="32" Height="32" 
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.AMC.Title}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Loc.AMC.Subtitle}" 
                                 FontSize="14" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TestConnectionButton" Content="{DynamicResource Loc.AMC.TestConnection}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5" Click="TestConnection_Click"/>
                    <Button x:Name="SaveConfigButton" Content="{DynamicResource Loc.AMC.SaveConfig}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5" Click="SaveConfig_Click"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 主要内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 全局设置 -->
                <TextBlock Text="{DynamicResource Loc.AMC.GlobalSettings}" Style="{StaticResource SectionHeaderStyle}"/>
                <materialDesign:Card Style="{StaticResource ModelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="{DynamicResource Loc.AMC.DefaultModel}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="DefaultModelComboBox" 
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.AMC.HintSelectModel}"
                                    Margin="0,0,0,15">
                                <ComboBoxItem Content="DeepSeek-V3"/>
                                <ComboBoxItem Content="GPT-4"/>
                                <ComboBoxItem Content="Claude-3"/>
                                <ComboBoxItem Content="Gemini-Pro"/>
                            </ComboBox>
                            
                            <TextBlock Text="{DynamicResource Loc.AMC.ApiKey}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="ApiKeyPasswordBox" 
                                       materialDesign:HintAssist.Hint="{DynamicResource Loc.AMC.HintEnterApiKey}"
                                       Margin="0,0,0,15"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Loc.AMC.RequestTimeout}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Slider x:Name="TimeoutSlider" 
                                  Minimum="10" Maximum="120" Value="30" 
                                  TickFrequency="10" IsSnapToTickEnabled="True"
                                  Margin="0,0,0,5"/>
                            <TextBlock x:Name="TimeoutLabel" Text="{DynamicResource Loc.AMC.Timeout30s}" 
                                     HorizontalAlignment="Center" FontSize="12" Opacity="0.7"
                                     Margin="0,0,0,15"/>
                            
                            <CheckBox x:Name="EnableCacheCheckBox" Content="{DynamicResource Loc.AMC.EnableCache}" 
                                    IsChecked="True" Margin="0,0,0,10"/>
                            <CheckBox x:Name="EnableLoggingCheckBox" Content="{DynamicResource Loc.AMC.EnableVerboseLog}" 
                                    IsChecked="False"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- 功能特定配置 -->
                <TextBlock Text="{DynamicResource Loc.AMC.FeatureConfig}" Style="{StaticResource SectionHeaderStyle}"/>
                
                <!-- 对话生成 -->
                <materialDesign:Card Style="{StaticResource ModelCardStyle}">
                    <Expander Header="{DynamicResource Loc.AMC.DialogueGen}" IsExpanded="True">
                        <Grid Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="{DynamicResource Loc.AMC.RecommendedModel}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DialogueModelComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.AMC.HintSelectDialogueModel}"
                                        SelectedIndex="0">
                                    <ComboBoxItem Tag="DeepSeek-V3 (推荐)" Content="{DynamicResource Loc.AMC.ModelDeepSeekRecommended}"/>
                                    <ComboBoxItem Content="GPT-4"/>
                                    <ComboBoxItem Content="Claude-3"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="{DynamicResource Loc.AMC.Creativity}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Slider x:Name="DialogueCreativitySlider" 
                                      Minimum="0" Maximum="1" Value="0.7" 
                                      TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{DynamicResource Loc.AMC.CreativityBalance}" HorizontalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Loc.AMC.MaxLength}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Slider x:Name="DialogueMaxLengthSlider" 
                                      Minimum="100" Maximum="2000" Value="800" 
                                      TickFrequency="100" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{DynamicResource Loc.AMC.Characters800}" HorizontalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </materialDesign:Card>

                <!-- 世界设定分析 -->
                <materialDesign:Card Style="{StaticResource ModelCardStyle}">
                    <Expander Header="{DynamicResource Loc.AMC.WorldAnalysis}" IsExpanded="False">
                        <Grid Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="{DynamicResource Loc.AMC.AnalysisModel}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="AnalysisModelComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.AMC.HintSelectAnalysisModel}"
                                        SelectedIndex="1">
                                    <ComboBoxItem Content="DeepSeek-V3"/>
                                    <ComboBoxItem Tag="GPT-4 (推荐)" Content="{DynamicResource Loc.AMC.ModelGpt4Recommended}"/>
                                    <ComboBoxItem Content="Claude-3"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="{DynamicResource Loc.AMC.AnalysisDepth}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="AnalysisDepthComboBox" SelectedIndex="1">
                                    <ComboBoxItem Tag="快速分析" Content="{DynamicResource Loc.AMC.QuickAnalysis}"/>
                                    <ComboBoxItem Tag="标准分析" Content="{DynamicResource Loc.AMC.StandardAnalysis}"/>
                                    <ComboBoxItem Tag="深度分析" Content="{DynamicResource Loc.AMC.DeepAnalysis}"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <CheckBox Content="{DynamicResource Loc.AMC.EnableConsistencyCheck}" IsChecked="True" Margin="0,0,0,5"/>
                                <CheckBox Content="{DynamicResource Loc.AMC.EnableLogicValidation}" IsChecked="True" Margin="0,0,0,5"/>
                                <CheckBox Content="{DynamicResource Loc.AMC.GenerateSuggestions}" IsChecked="True"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </materialDesign:Card>

                <!-- 势力关系分析 -->
                <materialDesign:Card Style="{StaticResource ModelCardStyle}">
                    <Expander Header="{DynamicResource Loc.AMC.FactionAnalysis}" IsExpanded="False">
                        <Grid Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="{DynamicResource Loc.AMC.FactionModel}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="FactionModelComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.AMC.HintSelectFactionModel}"
                                        SelectedIndex="0">
                                    <ComboBoxItem Tag="Claude-3 (推荐)" Content="{DynamicResource Loc.AMC.ModelClaude3Recommended}"/>
                                    <ComboBoxItem Content="GPT-4"/>
                                    <ComboBoxItem Content="DeepSeek-V3"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="{DynamicResource Loc.AMC.PredictionRange}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="PredictionRangeComboBox" SelectedIndex="1">
                                    <ComboBoxItem Tag="短期 (1-3章)" Content="{DynamicResource Loc.AMC.RangeShort}"/>
                                    <ComboBoxItem Tag="中期 (3-10章)" Content="{DynamicResource Loc.AMC.RangeMedium}"/>
                                    <ComboBoxItem Tag="长期 (10+章)" Content="{DynamicResource Loc.AMC.RangeLong}"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <CheckBox Content="{DynamicResource Loc.AMC.ConflictPrediction}" IsChecked="True" Margin="0,0,0,5"/>
                                <CheckBox Content="{DynamicResource Loc.AMC.AllianceAnalysis}" IsChecked="True" Margin="0,0,0,5"/>
                                <CheckBox Content="{DynamicResource Loc.AMC.PowerBalance}" IsChecked="False"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </materialDesign:Card>

                <!-- 性能监控 -->
                <TextBlock Text="{DynamicResource Loc.AMC.PerformanceMonitor}" Style="{StaticResource SectionHeaderStyle}"/>
                <materialDesign:Card Style="{StaticResource ModelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 响应时间 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc.AMC.AvgResponseTime}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <materialDesign:Card Background="{DynamicResource PrimaryHueMidBrush}" 
                                               Width="80" Height="80" Margin="0,10">
                                <TextBlock x:Name="ResponseTimeText" Text="2.3s" 
                                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- 成功率 -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc.AMC.SuccessRate}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <materialDesign:Card Background="{DynamicResource SecondaryHueMidBrush}" 
                                               Width="80" Height="80" Margin="0,10">
                                <TextBlock x:Name="SuccessRateText" Text="98.5%" 
                                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- 缓存命中率 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc.AMC.CacheHitRate}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <materialDesign:Card Background="#4CAF50" 
                                               Width="80" Height="80" Margin="0,10">
                                <TextBlock x:Name="CacheHitRateText" Text="76%" 
                                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- 今日请求数 -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc.AMC.TodayRequests}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <materialDesign:Card Background="#FF9800" 
                                               Width="80" Height="80" Margin="0,10">
                                <TextBlock x:Name="TodayRequestsText" Text="142" 
                                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </materialDesign:Card>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <materialDesign:Card Grid.Row="2" Margin="20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle" Foreground="Green" 
                                           Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Loc.AMC.StatusAllNormal}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Loc.AMC.ResetDefaults}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Margin="5,0" Click="ResetDefaults_Click"/>
                    <Button Content="{DynamicResource Loc.AMC.ExportConfig}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Margin="5,0" Click="ExportConfig_Click"/>
                    <Button Content="{DynamicResource Loc.AMC.ImportConfig}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Margin="5,0" Click="ImportConfig_Click"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
