<Window x:Class="NovelManagement.WPF.Views.AIChapterWriteDialog" Icon="pack://application:,,,/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{DynamicResource Loc.CWR.Title}" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{DynamicResource Loc.CWR.Title}"
                             FontSize="24"
                             FontWeight="Bold"
                             DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <!-- AI模型选择 -->
                        <ComboBox x:Name="AIModelComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintModel}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Width="120"
                                Margin="0,0,8,0">
                            <ComboBoxItem Content="DeepSeek" IsSelected="True"/>
                            <ComboBoxItem Content="Ollama"/>
                            <ComboBoxItem Content="RWKV"/>
                            <ComboBoxItem Content="GPT-4"/>
                        </ComboBox>
                        <!-- 模板管理 -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Click="ManageTemplates_Click"
                              ToolTip="{DynamicResource Loc.CWR.ManageTemplatesTip}">
                            <materialDesign:PackIcon Kind="FileDocument"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{DynamicResource Loc.CWR.Desc}"
                         FontSize="14"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                         Margin="0,8,0,0"/>

                <!-- 进度指示器 -->
                <ProgressBar x:Name="GenerationProgressBar"
                           Height="4"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"
                           Style="{StaticResource MaterialDesignLinearProgressBar}"/>

                <!-- 状态显示 -->
                <TextBlock x:Name="StatusTextBlock"
                         Text=""
                         Style="{StaticResource MaterialDesignCaptionTextBlock}"
                         Margin="0,4,0,0"
                         Visibility="Collapsed"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设置面板 -->
            <materialDesign:Card Grid.Column="0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.CWR.GenSettings}" 
                                 FontSize="16" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,16"/>

                        <!-- 章节标题 -->
                        <TextBox x:Name="ChapterTitleTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintChapterTitle}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Margin="0,0,0,12"/>

                        <!-- 写作风格 -->
                        <ComboBox x:Name="WritingStyleComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintWritingStyle}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Margin="0,0,0,12">
                            <ComboBoxItem Tag="现代都市" Content="{DynamicResource Loc.CWR.StyleUrban}"/>
                            <ComboBoxItem Tag="古风仙侠" Content="{DynamicResource Loc.CWR.StyleXianxia}" IsSelected="True"/>
                            <ComboBoxItem Tag="科幻未来" Content="{DynamicResource Loc.CWR.StyleScifi}"/>
                            <ComboBoxItem Tag="奇幻魔法" Content="{DynamicResource Loc.CWR.StyleFantasy}"/>
                            <ComboBoxItem Tag="历史军事" Content="{DynamicResource Loc.CWR.StyleMilitary}"/>
                            <ComboBoxItem Tag="悬疑推理" Content="{DynamicResource Loc.CWR.StyleMystery}"/>
                        </ComboBox>

                        <!-- 章节类型 -->
                        <ComboBox x:Name="ChapterTypeComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintChapterType}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Margin="0,0,0,12">
                            <ComboBoxItem Tag="正文章节" Content="{DynamicResource Loc.CWR.TypeNormal}" IsSelected="True"/>
                            <ComboBoxItem Tag="过渡章节" Content="{DynamicResource Loc.CWR.TypeTransition}"/>
                            <ComboBoxItem Tag="高潮章节" Content="{DynamicResource Loc.CWR.TypeClimax}"/>
                            <ComboBoxItem Tag="回忆章节" Content="{DynamicResource Loc.CWR.TypeFlashback}"/>
                            <ComboBoxItem Tag="番外章节" Content="{DynamicResource Loc.CWR.TypeExtra}"/>
                        </ComboBox>

                        <!-- 目标字数 -->
                        <TextBox x:Name="TargetWordCountTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintTargetWordCount}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="2800"
                               Margin="0,0,0,12"/>

                        <!-- 章节大纲 -->
                        <TextBox x:Name="ChapterOutlineTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintOutline}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               MinHeight="80"
                               MaxHeight="120"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,12"/>

                        <!-- 关键情节 -->
                        <TextBox x:Name="KeyPlotsTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintKeyPlots}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               MinHeight="60"
                               MaxHeight="100"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,12"/>

                        <!-- 出场角色 -->
                        <TextBox x:Name="CharactersTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintCharacters}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Margin="0,0,0,12"/>

                        <!-- 高级设置 -->
                        <Expander Header="{DynamicResource Loc.CWR.AdvancedSettings}" Margin="0,0,0,12">
                            <StackPanel Margin="0,8,0,0">
                                <!-- 创意程度 -->
                                <TextBlock Text="{DynamicResource Loc.CWR.Creativity}" FontWeight="Medium" Margin="0,0,0,4"/>
                                <Slider x:Name="CreativitySlider"
                                      Minimum="0" Maximum="100" Value="70"
                                      TickFrequency="10" TickPlacement="BottomRight"
                                      Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ElementName=CreativitySlider, Path=Value, StringFormat='{}{0:F0}%'}"
                                         HorizontalAlignment="Center"
                                         FontSize="12"
                                         Margin="0,0,0,12"/>

                                <!-- 分段生成 -->
                                <CheckBox x:Name="SegmentedGenerationCheckBox"
                                        Content="{DynamicResource Loc.CWR.SegmentedGen}"
                                        Margin="0,0,0,8"/>

                                <!-- 实时预览 -->
                                <CheckBox x:Name="RealTimePreviewCheckBox"
                                        Content="{DynamicResource Loc.CWR.RealTimePreview}"
                                        Margin="0,0,0,8"/>

                                <!-- 语言风格强度 -->
                                <TextBlock Text="{DynamicResource Loc.CWR.StyleIntensity}" FontWeight="Medium" Margin="0,8,0,4"/>
                                <ComboBox x:Name="StyleIntensityComboBox"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                        Margin="0,0,0,8">
                                    <ComboBoxItem Tag="轻度" Content="{DynamicResource Loc.CWR.IntensityLight}"/>
                                    <ComboBoxItem Tag="中度" Content="{DynamicResource Loc.CWR.IntensityMedium}" IsSelected="True"/>
                                    <ComboBoxItem Tag="强烈" Content="{DynamicResource Loc.CWR.IntensityStrong}"/>
                                </ComboBox>
                            </StackPanel>
                        </Expander>

                        <!-- 特殊要求 -->
                        <TextBox x:Name="SpecialRequirementsTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintSpecialReq}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               MinHeight="60"
                               MaxHeight="100"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,16"/>

                        <!-- 生成按钮组 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="GenerateButton"
                                  Grid.Column="0"
                                  Style="{StaticResource MaterialDesignRaisedButton}"
                                  Click="Generate_Click"
                                  IsEnabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RobotExcited" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc.CWR.StartGenerate}"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickGenerateButton"
                                  Grid.Column="2"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Click="QuickGenerate_Click"
                                  ToolTip="{DynamicResource Loc.CWR.QuickGenTip}">
                                <materialDesign:PackIcon Kind="Flash"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- 右侧：生成结果 -->
            <materialDesign:Card Grid.Column="2" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 结果标题 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc.CWR.Result}"
                                 FontSize="16"
                                 FontWeight="Medium"
                                 DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock x:Name="WordCountLabel"
                                     Text="{DynamicResource Loc.CWR.ZeroWords}"
                                     FontSize="14"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="QualityScoreLabel"
                                     Text=""
                                     FontSize="14"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </DockPanel>

                    <Expander x:Name="RwkvDebugExpander"
                              Grid.Row="1"
                              Header="{DynamicResource Loc.CWR.RwkvDebug}"
                              Margin="0,0,0,8"
                              IsExpanded="False">
                        <Border Padding="12"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Loc.CWR.EngineLabel}" FontWeight="Medium" Margin="0,0,8,4"/>
                                <TextBlock x:Name="RwkvEngineInfoTextBlock" Grid.Row="0" Grid.Column="1" Text="-" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Loc.CWR.SessionLabel}" FontWeight="Medium" Margin="0,0,8,4"/>
                                <TextBlock x:Name="RwkvSessionInfoTextBlock" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Loc.CWR.BatchLabel}" FontWeight="Medium" Margin="0,0,8,4"/>
                                <TextBlock x:Name="RwkvBigBatchInfoTextBlock" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Loc.CWR.LastSelectionLabel}" FontWeight="Medium" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RwkvBigBatchSelectionTextBlock" Grid.Row="3" Grid.Column="1" Text="-" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- 生成内容 -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="GeneratedContentTextBox"
                               Grid.Row="0"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               IsReadOnly="False"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CWR.HintGeneratedPlaceholder}"
                               TextChanged="GeneratedContentTextBox_TextChanged"/>

                        <!-- 实时统计 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="CharacterCountLabel" Text="{DynamicResource Loc.CWR.CharCount0}" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock x:Name="ParagraphCountLabel" Text="{DynamicResource Loc.CWR.ParaCount0}" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock x:Name="ReadingTimeLabel" Text="{DynamicResource Loc.CWR.ReadingTime0}" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="4"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Margin="0,16,0,0">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="0,0,8,0"
                              Click="SaveTemplate_Click"
                              ToolTip="{DynamicResource Loc.CWR.SaveAsTemplateTip}">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="0,0,8,0"
                              Click="Regenerate_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CWR.Regenerate}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="0,0,8,0"
                              Click="CopyToClipboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.Dlg.Copy}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="0,0,8,0"
                              Click="PolishContent_Click"
                              ToolTip="{DynamicResource Loc.CWR.PolishContentTip}">
                            <materialDesign:PackIcon Kind="AutoFix"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" 
                  Orientation="Horizontal" 
                  HorizontalAlignment="Right"
                  Margin="0,24,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                  Margin="0,0,8,0"
                  Click="Cancel_Click">
                <TextBlock Text="{DynamicResource Loc.Dlg.Cancel}"/>
            </Button>
            
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                  Click="Apply_Click"
                  x:Name="ApplyButton">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource Loc.CWR.ApplyContent}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
</Window>
