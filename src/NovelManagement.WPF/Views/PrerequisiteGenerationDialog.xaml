<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NovelManagement.WPF.Views.PrerequisiteGenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Loc.PG.Title}" 
        Height="760"
        Width="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题和说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Loc.PG.Header}" 
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="{DynamicResource Loc.PG.Desc}"
                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- 主要内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.ProjectSelection}"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProjectComboBox"
                                      Grid.Column="0"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="ProjectId"
                                      SelectionChanged="ProjectComboBox_SelectionChanged"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.PG.HintSelectProject}"/>

                            <TextBlock x:Name="ProjectSummaryTextBlock"
                                       Grid.Column="2"
                                       Text="{DynamicResource Loc.PG.SummaryPlaceholder}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.ContextSummary}"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <TextBox x:Name="ContextSummaryTextBox"
                                 Height="180"
                                 IsReadOnly="True"
                                 Text="{DynamicResource Loc.PG.ContextPlaceholder}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.FlowChart}"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <UniformGrid Columns="5">
                            <Border Margin="4" Padding="10" CornerRadius="8"
                                    Background="{DynamicResource AppPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PG.StageProject}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ProjectInfoStageTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="4" Padding="10" CornerRadius="8"
                                    Background="{DynamicResource AppPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PG.StageWorld}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WorldStageTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="4" Padding="10" CornerRadius="8"
                                    Background="{DynamicResource AppPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PG.StageOutline}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OutlineStageTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="4" Padding="10" CornerRadius="8"
                                    Background="{DynamicResource AppPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PG.StageSupport}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SupportStageTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="4" Padding="10" CornerRadius="8"
                                    Background="{DynamicResource AppPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PG.StageWriting}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WritingStageTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 当前状态 -->
                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.DataStatus}" 
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock x:Name="PlotsStatusTextBlock" 
                                           Text="{DynamicResource Loc.PG.PlotsChecking}" 
                                           Margin="0,2"/>
                                <TextBlock x:Name="CharactersStatusTextBlock" 
                                           Text="{DynamicResource Loc.PG.CharactersChecking}" 
                                           Margin="0,2"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="WorldSettingsStatusTextBlock"
                                           Text="{DynamicResource Loc.PG.WorldChecking}"
                                           Margin="0,2"/>
                                <TextBlock x:Name="FactionsStatusTextBlock"
                                           Text="{DynamicResource Loc.PG.FactionsChecking}"
                                           Margin="0,2"/>
                                <TextBlock x:Name="CultivationSystemStatusTextBlock"
                                           Text="{DynamicResource Loc.PG.CultivationChecking}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 生成选项 -->
                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.Options}"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <!-- 基础生成选项 -->
                        <CheckBox x:Name="GeneratePlotsCheckBox"
                                  Content="{DynamicResource Loc.PG.GenPlots}"
                                  Margin="0,5"
                                  IsChecked="True"/>

                        <CheckBox x:Name="GenerateCharactersCheckBox"
                                  Content="{DynamicResource Loc.PG.GenCharacters}"
                                  Margin="0,5"
                                  IsChecked="True"/>

                        <CheckBox x:Name="GenerateWorldSettingsCheckBox"
                                  Content="{DynamicResource Loc.PG.GenWorld}"
                                  Margin="0,5"
                                  IsChecked="True"/>

                        <CheckBox x:Name="GenerateFactionsCheckBox"
                                  Content="{DynamicResource Loc.PG.GenFactions}"
                                  Margin="0,5"
                                  IsChecked="True"/>

                        <CheckBox x:Name="GenerateCultivationSystemCheckBox"
                                  Content="{DynamicResource Loc.PG.GenCultivation}"
                                  Margin="0,5"
                                  IsChecked="True"/>

                        <!-- 高级选项 -->
                        <Expander Header="{DynamicResource Loc.PG.AdvancedOptions}" Margin="0,10,0,0">
                            <StackPanel Margin="20,10,0,0">
                                <!-- 书籍类型选择 -->
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{DynamicResource Loc.PG.GenreLabel}" VerticalAlignment="Center" Width="80"/>
                                    <ComboBox x:Name="NovelGenreComboBox" Width="150" SelectedIndex="0">
                                        <ComboBoxItem Tag="修仙" Content="{DynamicResource Loc.PG.GenreXianxia}"/>
                                        <ComboBoxItem Tag="都市" Content="{DynamicResource Loc.PG.GenreUrban}"/>
                                        <ComboBoxItem Tag="玄幻" Content="{DynamicResource Loc.PG.GenreFantasy}"/>
                                        <ComboBoxItem Tag="科幻" Content="{DynamicResource Loc.PG.GenreScifi}"/>
                                        <ComboBoxItem Tag="历史" Content="{DynamicResource Loc.PG.GenreHistory}"/>
                                        <ComboBoxItem Tag="其他" Content="{DynamicResource Loc.PG.GenreOther}"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 世界观风格 -->
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{DynamicResource Loc.PG.WorldLabel}" VerticalAlignment="Center" Width="80"/>
                                    <ComboBox x:Name="WorldStyleComboBox" Width="150" SelectedIndex="0">
                                        <ComboBoxItem Tag="东方玄幻" Content="{DynamicResource Loc.PG.WorldEastern}"/>
                                        <ComboBoxItem Tag="西方奇幻" Content="{DynamicResource Loc.PG.WorldWestern}"/>
                                        <ComboBoxItem Tag="现代都市" Content="{DynamicResource Loc.PG.WorldModern}"/>
                                        <ComboBoxItem Tag="未来科幻" Content="{DynamicResource Loc.PG.WorldFuture}"/>
                                        <ComboBoxItem Tag="古代历史" Content="{DynamicResource Loc.PG.WorldAncient}"/>
                                        <ComboBoxItem Tag="混合风格" Content="{DynamicResource Loc.PG.WorldMixed}"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- AI生成选项 -->
                                <CheckBox x:Name="UseAIGenerationCheckBox"
                                          Content="{DynamicResource Loc.PG.UseAiGen}"
                                          Margin="0,10,0,5"/>

                                <TextBox x:Name="AIPromptTextBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.PG.HintAiPrompt}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         TextWrapping="Wrap"
                                         Height="60"
                                         Margin="0,5"
                                         IsEnabled="{Binding IsChecked, ElementName=UseAIGenerationCheckBox}"/>

                                <!-- 允许后续编辑 -->
                                <CheckBox x:Name="AllowUserEditingCheckBox"
                                          Content="{DynamicResource Loc.PG.AllowEditing}"
                                          Margin="0,10,0,0"
                                          IsChecked="True"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 生成进度 -->
                <materialDesign:Card x:Name="ProgressCard" 
                                     Margin="0,0,0,15" 
                                     Padding="15"
                                     Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.Progress}" 
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>
                        
                        <ProgressBar x:Name="GenerationProgressBar" 
                                     Height="8" 
                                     Margin="0,0,0,10"/>
                        
                        <TextBlock x:Name="ProgressStatusTextBlock" 
                                   Text="{DynamicResource Loc.PG.Preparing}" 
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 生成结果 -->
                <materialDesign:Card x:Name="ResultCard" 
                                     Margin="0,0,0,15" 
                                     Padding="15"
                                     Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PG.Result}" 
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,10"/>
                        
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ResultTextBlock" 
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">

            <Button x:Name="BackButton"
                    Content="{DynamicResource Loc.PG.Back}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,10,0"
                    Click="Back_Click"/>
            
            <Button x:Name="CheckStatusButton"
                    Content="{DynamicResource Loc.PG.CheckStatus}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,10,0"
                    Click="CheckStatus_Click">
                <Button.ToolTip>
                    <ToolTip Content="{DynamicResource Loc.PG.CheckStatusTip}"/>
                </Button.ToolTip>
            </Button>
            
            <Button x:Name="GenerateButton"
                    Content="{DynamicResource Loc.PG.StartGenerate}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Click="Generate_Click">
                <Button.ToolTip>
                    <ToolTip Content="{DynamicResource Loc.PG.GenerateTip}"/>
                </Button.ToolTip>
            </Button>
            
            <Button x:Name="CloseButton"
                    Content="{DynamicResource Loc.Dlg.Close}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
