<UserControl x:Class="NovelManagement.WPF.Views.DialogGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        
        <Style x:Key="InfoCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="20" materialDesign:ShadowAssist.ShadowDepth="Depth2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MessageText" Width="32" Height="32" 
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.DG.Title}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Loc.DG.Subtitle}" 
                                 FontSize="14" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveTemplateButton" Content="{DynamicResource Loc.DG.SaveTemplate}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5" Click="SaveTemplate_Click"/>
                    <Button x:Name="LoadTemplateButton" Content="{DynamicResource Loc.DG.LoadTemplate}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5" Click="LoadTemplate_Click"/>
                    <Button x:Name="HelpButton" Content="{DynamicResource Loc.DG.Help}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5" Click="Help_Click"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：参数配置区域 -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource InfoCardStyle}" Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.DG.Params}" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <!-- 角色设置 -->
                        <Expander Header="{DynamicResource Loc.DG.CharacterSettings}" IsExpanded="True" Margin="0,10">
                            <StackPanel Margin="20,10">
                                <TextBlock Text="{DynamicResource Loc.DG.Characters}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="CharactersTextBox" 
                                       materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintCharacterNames}"
                                       Text="{DynamicResource Loc.DG.SampleChars}"
                                       Margin="0,0,0,10"/>
                                
                                <TextBlock Text="{DynamicResource Loc.DG.Relationship}" FontWeight="Bold" Margin="0,10,0,5"/>
                                <ComboBox x:Name="RelationshipComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintSelectRelationship}"
                                        Margin="0,0,0,10">
                                    <ComboBoxItem Tag="朋友" Content="{DynamicResource Loc.DG.RelFriend}"/>
                                    <ComboBoxItem Tag="恋人" Content="{DynamicResource Loc.DG.RelLover}"/>
                                    <ComboBoxItem Tag="敌人" Content="{DynamicResource Loc.DG.RelEnemy}"/>
                                    <ComboBoxItem Tag="师徒" Content="{DynamicResource Loc.DG.RelMentor}"/>
                                    <ComboBoxItem Tag="上下级" Content="{DynamicResource Loc.DG.RelHierarchy}"/>
                                    <ComboBoxItem Tag="陌生人" Content="{DynamicResource Loc.DG.RelStranger}"/>
                                    <ComboBoxItem Tag="家人" Content="{DynamicResource Loc.DG.RelFamily}"/>
                                </ComboBox>
                                
                                <Button x:Name="SelectCharactersButton" Content="{DynamicResource Loc.DG.SelectFromLibrary}" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Click="SelectCharacters_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 情境设置 -->
                        <Expander Header="{DynamicResource Loc.DG.SituationSettings}" IsExpanded="True" Margin="0,10">
                            <StackPanel Margin="20,10">
                                <TextBlock Text="{DynamicResource Loc.DG.Scene}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="SituationTextBox" 
                                       materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintScene}"
                                       Text="{DynamicResource Loc.DG.SceneDefault}"
                                       AcceptsReturn="True" 
                                       Height="80"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                                
                                <TextBlock Text="{DynamicResource Loc.DG.Purpose}" FontWeight="Bold" Margin="0,10,0,5"/>
                                <ComboBox x:Name="PurposeComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintSelectPurpose}"
                                        Margin="0,0,0,10">
                                    <ComboBoxItem Tag="推进剧情" Content="{DynamicResource Loc.DG.PurposePlot}"/>
                                    <ComboBoxItem Tag="角色发展" Content="{DynamicResource Loc.DG.PurposeCharacter}"/>
                                    <ComboBoxItem Tag="信息传递" Content="{DynamicResource Loc.DG.PurposeInfo}"/>
                                    <ComboBoxItem Tag="情感表达" Content="{DynamicResource Loc.DG.PurposeEmotion}"/>
                                    <ComboBoxItem Tag="冲突展现" Content="{DynamicResource Loc.DG.PurposeConflict}"/>
                                    <ComboBoxItem Tag="氛围营造" Content="{DynamicResource Loc.DG.PurposeAtmosphere}"/>
                                </ComboBox>
                            </StackPanel>
                        </Expander>

                        <!-- 风格设置 -->
                        <Expander Header="{DynamicResource Loc.DG.StyleSettings}" IsExpanded="True" Margin="0,10">
                            <StackPanel Margin="20,10">
                                <TextBlock Text="{DynamicResource Loc.DG.EmotionTone}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="EmotionComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintSelectEmotion}"
                                        Margin="0,0,0,10">
                                    <ComboBoxItem Tag="平静" Content="{DynamicResource Loc.DG.EmotionCalm}"/>
                                    <ComboBoxItem Tag="高兴" Content="{DynamicResource Loc.DG.EmotionHappy}"/>
                                    <ComboBoxItem Tag="愤怒" Content="{DynamicResource Loc.DG.EmotionAngry}"/>
                                    <ComboBoxItem Tag="悲伤" Content="{DynamicResource Loc.DG.EmotionSad}"/>
                                    <ComboBoxItem Tag="紧张" Content="{DynamicResource Loc.DG.EmotionTense}"/>
                                    <ComboBoxItem Tag="兴奋" Content="{DynamicResource Loc.DG.EmotionExcited}"/>
                                    <ComboBoxItem Tag="恐惧" Content="{DynamicResource Loc.DG.EmotionFear}"/>
                                    <ComboBoxItem Tag="惊讶" Content="{DynamicResource Loc.DG.EmotionSurprised}"/>
                                </ComboBox>
                                
                                <TextBlock Text="{DynamicResource Loc.DG.LanguageStyle}" FontWeight="Bold" Margin="0,10,0,5"/>
                                <ComboBox x:Name="StyleComboBox" 
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintSelectStyle}"
                                        Margin="0,0,0,10">
                                    <ComboBoxItem Tag="现代口语" Content="{DynamicResource Loc.DG.StyleModern}"/>
                                    <ComboBoxItem Tag="古典文雅" Content="{DynamicResource Loc.DG.StyleClassical}"/>
                                    <ComboBoxItem Tag="武侠风格" Content="{DynamicResource Loc.DG.StyleWuxia}"/>
                                    <ComboBoxItem Tag="仙侠风格" Content="{DynamicResource Loc.DG.StyleXianxia}"/>
                                    <ComboBoxItem Tag="现代都市" Content="{DynamicResource Loc.DG.StyleUrban}"/>
                                    <ComboBoxItem Tag="科幻未来" Content="{DynamicResource Loc.DG.StyleScifi}"/>
                                </ComboBox>
                                
                                <TextBlock Text="{DynamicResource Loc.DG.DialogueLength}" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Slider x:Name="LengthSlider" 
                                      Minimum="1" Maximum="10" Value="5" 
                                      TickFrequency="1" IsSnapToTickEnabled="True"
                                      Margin="0,0,0,5"/>
                                <TextBlock x:Name="LengthLabel" Text="{DynamicResource Loc.DG.LengthMedium}" 
                                         HorizontalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                        </Expander>

                        <!-- 生成按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                            <Button x:Name="GenerateButton" Content="{DynamicResource Loc.DG.GenerateDialogue}" 
                                  Style="{StaticResource MaterialDesignRaisedButton}"
                                  Width="120" Height="40"
                                  Click="Generate_Click"/>
                            <Button x:Name="OptimizeButton" Content="{DynamicResource Loc.DG.OptimizeDialogue}" 
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Width="120" Height="40" Margin="10,0,0,0"
                                  Click="Optimize_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- 右侧：结果显示区域 -->
            <materialDesign:Card Grid.Column="1" Style="{StaticResource InfoCardStyle}" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 结果标题 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Loc.DG.Result}" Style="{StaticResource SectionHeaderStyle}"/>
                        <materialDesign:Chip x:Name="QualityChip" Content="{DynamicResource Loc.DG.QualityScoreDashes}" 
                                           Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 对话内容显示 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ResultTextBox" 
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.DG.HintResultPlaceholder}"
                               AcceptsReturn="True" 
                               TextWrapping="Wrap"
                               IsReadOnly="False"
                               MinHeight="400"/>
                    </ScrollViewer>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="CopyButton" Content="{DynamicResource Loc.Dlg.Copy}" 
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="5" Click="Copy_Click"/>
                        <Button x:Name="SaveButton" Content="{DynamicResource Loc.Dlg.Save}" 
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="5" Click="Save_Click"/>
                        <Button x:Name="ExportButton" Content="{DynamicResource Loc.Dlg.Export}" 
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="5" Click="Export_Click"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- 加载指示器 -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                           Width="50" Height="50" IsIndeterminate="True"/>
                <TextBlock x:Name="LoadingText" Text="{DynamicResource Loc.DG.Generating}" 
                         Foreground="White" FontSize="16" Margin="0,20,0,0" 
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
