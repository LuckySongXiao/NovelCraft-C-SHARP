<Window x:Class="NovelManagement.WPF.Views.AIOutlineGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{DynamicResource Loc.OG.Title}" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:Card Grid.Row="0" Margin="16,16,16,8" Padding="24">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.OG.Title}" 
                         FontSize="24" 
                         FontWeight="Bold" 
                         Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Loc.OG.Subtitle}" 
                         FontSize="14" 
                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：输入参数 -->
                <materialDesign:Card Grid.Column="0" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.OG.Params}" 
                                 FontSize="18" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,16"/>

                        <!-- 书籍主题 -->
                        <TextBox x:Name="ThemeTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintTheme}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Margin="0,0,0,16"/>

                        <!-- 书籍类型 -->
                        <ComboBox x:Name="NovelTypeComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintNovelType}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Margin="0,0,0,16">
                            <ComboBoxItem Tag="修仙书籍" Content="{DynamicResource Loc.OG.TypeXianxia}"/>
                            <ComboBoxItem Tag="都市书籍" Content="{DynamicResource Loc.OG.TypeUrban}"/>
                            <ComboBoxItem Tag="玄幻书籍" Content="{DynamicResource Loc.OG.TypeFantasy}"/>
                            <ComboBoxItem Tag="科幻书籍" Content="{DynamicResource Loc.OG.TypeScifi}"/>
                            <ComboBoxItem Tag="历史书籍" Content="{DynamicResource Loc.OG.TypeHistory}"/>
                            <ComboBoxItem Tag="武侠书籍" Content="{DynamicResource Loc.OG.TypeWuxia}"/>
                            <ComboBoxItem Tag="言情书籍" Content="{DynamicResource Loc.OG.TypeRomance}"/>
                            <ComboBoxItem Tag="悬疑书籍" Content="{DynamicResource Loc.OG.TypeMystery}"/>
                        </ComboBox>

                        <!-- 目标长度 -->
                        <ComboBox x:Name="TargetLengthComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintTargetLength}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Margin="0,0,0,16">
                            <ComboBoxItem Tag="短篇（5-10万字）" Content="{DynamicResource Loc.OG.LenShort}"/>
                            <ComboBoxItem Tag="中篇（10-30万字）" Content="{DynamicResource Loc.OG.LenMedium}"/>
                            <ComboBoxItem Tag="长篇（30-100万字）" Content="{DynamicResource Loc.OG.LenLong}"/>
                            <ComboBoxItem Tag="超长篇（100万字以上）" Content="{DynamicResource Loc.OG.LenEpic}"/>
                        </ComboBox>

                        <!-- 主角设定 -->
                        <TextBox x:Name="MainCharacterTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintMainCharacter}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Height="80"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,16"/>

                        <!-- 背景设定 -->
                        <TextBox x:Name="SettingTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintSetting}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Height="80"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,16"/>

                        <!-- 特殊要求 -->
                        <TextBox x:Name="RequirementsTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintRequirements}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Height="100"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,16"/>

                        <!-- 生成按钮 -->
                        <Button x:Name="GenerateButton"
                              Content="{DynamicResource Loc.OG.StartGenerate}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Background="{DynamicResource PrimaryHueMidBrush}"
                              Foreground="White"
                              Height="40"
                              Click="GenerateButton_Click"/>

                        <!-- 进度条 -->
                        <ProgressBar x:Name="ProgressBar"
                                   Visibility="Collapsed"
                                   Margin="0,16,0,0"
                                   Height="4"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 右侧：生成结果 -->
                <materialDesign:Card Grid.Column="2" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.OG.Result}" 
                                 FontSize="18" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,16"/>

                        <!-- 结果显示区域 -->
                        <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="ResultTextBox"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   TextWrapping="Wrap"
                                   AcceptsReturn="True"
                                   IsReadOnly="True"
                                   Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                   materialDesign:HintAssist.Hint="{DynamicResource Loc.OG.HintResultPlaceholder}"/>
                        </ScrollViewer>

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right" 
                                  Margin="0,16,0,0">
                            <Button Content="{DynamicResource Loc.OG.Regenerate}"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Margin="0,0,8,0"
                                  Click="RegenerateButton_Click"/>
                            <Button Content="{DynamicResource Loc.OG.SaveOutline}"
                                  Style="{StaticResource MaterialDesignRaisedButton}"
                                  Background="{DynamicResource SecondaryHueMidBrush}"
                                  Foreground="White"
                                  Click="SaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" 
                  Orientation="Horizontal" 
                  HorizontalAlignment="Right" 
                  Margin="16">
            <Button Content="{DynamicResource Loc.Dlg.Cancel}" 
                  Style="{StaticResource MaterialDesignFlatButton}"
                  Margin="0,0,8,0"
                  Click="CancelButton_Click"/>
            <Button Content="{DynamicResource Loc.Dlg.OK}" 
                  Style="{StaticResource MaterialDesignRaisedButton}"
                  Background="{DynamicResource PrimaryHueMidBrush}"
                  Foreground="White"
                  Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
