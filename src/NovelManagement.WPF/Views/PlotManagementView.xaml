<UserControl x:Class="NovelManagement.WPF.Views.PlotManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:localization="clr-namespace:NovelManagement.WPF.Localization"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <localization:StoredValueConverter x:Key="StoredValueConverter"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Loc.PLM.Title}" 
                     FontSize="32" 
                     FontWeight="Bold" 
                     Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Loc.PLM.Subtitle}" 
                     FontSize="16" 
                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- 操作工具栏 -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,12,0"
                            Click="NewPlot_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.New}"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="ViewTimeline_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Timeline" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.TimelineView}"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="PlotAnalysis_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.Analysis}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="ExportPlots_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.Export}"/>
                        </StackPanel>
                    </Button>

                    <!-- AI辅助功能分隔符 -->
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                             Margin="12,0"/>

                    <!-- AI辅助按钮组 -->
                    <Button Style="{StaticResource MaterialDesignRaisedAccentButton}"
                            Margin="0,0,8,0"
                            Click="AIGeneratePlot_Click"
                            ToolTip="{DynamicResource Loc.PLM.AIGenerateTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Brain" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.AIGenerate}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            Click="AIOptimizePlot_Click"
                            ToolTip="{DynamicResource Loc.PLM.AIOptimizeTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AutoFix" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.AIOptimize}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            Click="AIPlotContinuity_Click"
                            ToolTip="{DynamicResource Loc.PLM.AIConsistencyTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.ConsistencyCheck}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="AIPlotSuggestions_Click"
                            ToolTip="{DynamicResource Loc.PLM.AISuggestTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lightbulb" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.PLM.Suggestions}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 筛选和搜索 -->
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <ComboBox x:Name="PlotTypeFilter"
                            materialDesign:HintAssist.Hint="{DynamicResource Loc.PLM.TypeHint}"
                            Width="120"
                            Margin="0,0,12,0"
                            SelectionChanged="PlotTypeFilter_SelectionChanged">
                        <ComboBoxItem Tag="全部" Content="{DynamicResource Loc.PLM.TypeAll}"/>
                        <ComboBoxItem Tag="主线" Content="{DynamicResource Loc.PLM.TypeMain}"/>
                        <ComboBoxItem Tag="支线" Content="{DynamicResource Loc.PLM.TypeSub}"/>
                        <ComboBoxItem Tag="伏笔" Content="{DynamicResource Loc.PLM.TypeForeshadow}"/>
                        <ComboBoxItem Tag="回忆" Content="{DynamicResource Loc.PLM.TypeFlashback}"/>
                        <ComboBoxItem Tag="番外" Content="{DynamicResource Loc.PLM.TypeExtra}"/>
                    </ComboBox>
                    
                    <ComboBox x:Name="PlotStatusFilter"
                            materialDesign:HintAssist.Hint="{DynamicResource Loc.PLM.StatusHint}"
                            Width="120"
                            Margin="0,0,12,0"
                            SelectionChanged="PlotStatusFilter_SelectionChanged">
                        <ComboBoxItem Tag="全部" Content="{DynamicResource Loc.PLM.TypeAll}"/>
                        <ComboBoxItem Tag="规划中" Content="{DynamicResource Loc.PLM.StatusPlanned}"/>
                        <ComboBoxItem Tag="进行中" Content="{DynamicResource Loc.PLM.StatusInProgress}"/>
                        <ComboBoxItem Tag="已完成" Content="{DynamicResource Loc.PLM.StatusCompleted}"/>
                        <ComboBoxItem Tag="暂停" Content="{DynamicResource Loc.PLM.StatusPaused}"/>
                    </ComboBox>
                    
                    <TextBox x:Name="SearchTextBox"
                           materialDesign:HintAssist.Hint="{DynamicResource Loc.PLM.SearchHint}"
                           materialDesign:TextFieldAssist.HasLeadingIcon="True"
                           materialDesign:TextFieldAssist.LeadingIcon="Search"
                           Width="200"
                           TextChanged="SearchTextBox_TextChanged"/>
                </WrapPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 主内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：剧情列表 -->
            <materialDesign:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Grid.Row="0" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,12">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Loc.PLM.List}" FontWeight="Medium" DockPanel.Dock="Left"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton x:Name="GroupByTypeToggle"
                                            Style="{StaticResource MaterialDesignActionToggleButton}"
                                            ToolTip="{DynamicResource Loc.PLM.GroupByTypeTooltip}"
                                            IsChecked="False"
                                            Checked="GroupBy_Changed"
                                            Unchecked="GroupBy_Changed">
                                    <materialDesign:PackIcon Kind="Group"/>
                                </ToggleButton>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 剧情列表 -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PlotListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding SelectPlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 剧情标题和状态 -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                <materialDesign:PackIcon DockPanel.Dock="Right"
                                                                       Kind="ChevronRight"
                                                                       Width="16" Height="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="{Binding Title}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"
                                                         TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <!-- 剧情类型和状态标签 -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                                <materialDesign:Chip Content="{Binding Type, Converter={StaticResource StoredValueConverter}}" 
                                                                   FontSize="10"
                                                                   Height="20"
                                                                   Background="{Binding TypeColor}"
                                                                   Margin="0,0,4,0"/>
                                                <materialDesign:Chip Content="{Binding Status, Converter={StaticResource StoredValueConverter}}" 
                                                                   FontSize="10"
                                                                   Height="20"
                                                                   Background="{Binding StatusColor}"/>
                                            </StackPanel>

                                            <!-- 剧情描述和进度 -->
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding Description}" 
                                                         FontSize="12"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         TextWrapping="Wrap"
                                                         MaxHeight="40"
                                                         TextTrimming="CharacterEllipsis"
                                                         Margin="0,0,0,4"/>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right"
                                                             Text="{Binding Progress, StringFormat='{}{0}%'}"
                                                             FontSize="12"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    <ProgressBar Value="{Binding Progress}" 
                                                               Maximum="100"
                                                               Height="4"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- 右侧：剧情详细信息 -->
            <Grid Grid.Column="2" x:Name="DetailArea">
                <!-- 默认显示剧情统计信息 -->
                <materialDesign:Card Padding="24" x:Name="DefaultCard">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PLM.Stats}" 
                                 FontSize="24" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,24"/>

                        <!-- 统计卡片 -->
                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <materialDesign:Card Margin="0,0,8,8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PLM.TotalCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="18" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="8,0,0,8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PLM.MainCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="5" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="0,8,8,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PLM.SubCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="10" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="8,8,0,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PLM.Progress}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="65%" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </UniformGrid>

                        <!-- 剧情状态分布 -->
                        <TextBlock Text="{DynamicResource Loc.PLM.StatusDistribution}" 
                                 FontSize="18" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,16"/>

                        <ItemsControl>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Chip Grid.Column="0" Content="{DynamicResource Loc.PLM.StatusCompleted}" Margin="0,0,12,0" Background="#4CAF50"/>
                                <ProgressBar Grid.Column="1" Value="8" Maximum="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Chip Grid.Column="0" Content="{DynamicResource Loc.PLM.StatusInProgress}" Margin="0,0,12,0" Background="#2196F3"/>
                                <ProgressBar Grid.Column="1" Value="6" Maximum="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Chip Grid.Column="0" Content="{DynamicResource Loc.PLM.StatusPlanned}" Margin="0,0,12,0" Background="#FF9800"/>
                                <ProgressBar Grid.Column="1" Value="4" Maximum="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </ItemsControl>

                        <!-- 最近更新的剧情 -->
                        <TextBlock Text="{DynamicResource Loc.PLM.RecentUpdate}" 
                                 FontSize="18" 
                                 FontWeight="Medium" 
                                 Margin="0,24,0,16"/>

                        <ItemsControl>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                  BorderThickness="0,0,0,1" 
                                  Padding="0,0,0,8" 
                                  Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Loc.PLM.SampleMain}" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource Loc.PLM.SampleMainDesc}" 
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 FontSize="12"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" 
                                             Text="{DynamicResource Loc.PLM.HoursAgo2}" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                  BorderThickness="0,0,0,1" 
                                  Padding="0,0,0,8" 
                                  Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Loc.PLM.SampleSub}" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource Loc.PLM.SampleSubDesc}" 
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 FontSize="12"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" 
                                             Text="{DynamicResource Loc.PLM.DayAgo1}" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
