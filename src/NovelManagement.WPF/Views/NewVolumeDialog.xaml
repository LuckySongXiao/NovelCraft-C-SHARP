<Window x:Class="NovelManagement.WPF.Views.NewVolumeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{DynamicResource Loc.VM.NewVolume}" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="BookPlus"
                                   Width="48" Height="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="{DynamicResource Loc.VM.NewVolume}"
                     FontSize="24"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="0,8,0,0"/>
            <TextBlock Text="{DynamicResource Loc.NVD.Subtitle}"
                     FontSize="14"
                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 卷宗名称 -->
                <TextBox x:Name="VolumeNameTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.NameHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       MaxLength="100"/>

                <!-- 卷宗描述 -->
                <TextBox x:Name="VolumeDescriptionTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.DescriptionHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       MinHeight="80"
                       MaxHeight="120"
                       VerticalScrollBarVisibility="Auto"
                       Margin="0,0,0,16"
                       MaxLength="500"/>

                <!-- 卷宗类型 -->
                <ComboBox x:Name="VolumeTypeComboBox"
                        materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.TypeHint}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Margin="0,0,0,16">
                    <ComboBoxItem Tag="主线剧情" Content="{DynamicResource Loc.NVD.TypeMain}"/>
                    <ComboBoxItem Tag="支线剧情" Content="{DynamicResource Loc.NVD.TypeSub}"/>
                    <ComboBoxItem Tag="番外篇" Content="{DynamicResource Loc.NVD.TypeExtra}"/>
                    <ComboBoxItem Tag="序章" Content="{DynamicResource Loc.NVD.TypePrologue}"/>
                    <ComboBoxItem Tag="终章" Content="{DynamicResource Loc.NVD.TypeFinale}"/>
                    <ComboBoxItem Tag="其他" Content="{DynamicResource Loc.PG.GenreOther}"/>
                </ComboBox>

                <!-- 卷宗顺序 -->
                <TextBox x:Name="VolumeOrderTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.OrderHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       PreviewTextInput="NumberOnly_PreviewTextInput"/>

                <!-- 目标章节数 -->
                <TextBox x:Name="TargetChapterCountTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.TargetChaptersHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       PreviewTextInput="NumberOnly_PreviewTextInput"/>

                <!-- 预计字数 -->
                <TextBox x:Name="EstimatedWordCountTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.EstimatedWordsHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       PreviewTextInput="NumberOnly_PreviewTextInput"/>

                <!-- 卷宗主题 -->
                <TextBox x:Name="VolumeThemeTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.ThemeHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       MaxLength="200"/>

                <!-- 关键角色 -->
                <TextBox x:Name="KeyCharactersTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.KeyCharactersHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       MaxLength="300"/>

                <!-- 重要事件 -->
                <TextBox x:Name="ImportantEventsTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.ImportantEventsHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       MinHeight="60"
                       MaxHeight="100"
                       VerticalScrollBarVisibility="Auto"
                       Margin="0,0,0,16"
                       MaxLength="500"/>

                <!-- 卷宗状态 -->
                <ComboBox x:Name="VolumeStatusComboBox"
                        materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.StatusHint}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Margin="0,0,0,16">
                    <ComboBoxItem Tag="计划中" Content="{DynamicResource Loc.TL.Data.计划中}" IsSelected="True"/>
                    <ComboBoxItem Tag="进行中" Content="{DynamicResource Loc.PLM.StatusInProgress}"/>
                    <ComboBoxItem Tag="已完成" Content="{DynamicResource Loc.PLM.StatusCompleted}"/>
                    <ComboBoxItem Tag="暂停" Content="{DynamicResource Loc.PLM.StatusPaused}"/>
                    <ComboBoxItem Tag="已取消" Content="{DynamicResource Loc.TL.Data.已取消}"/>
                </ComboBox>

                <!-- 标签 -->
                <TextBox x:Name="VolumeTagsTextBox"
                       materialDesign:HintAssist.Hint="{DynamicResource Loc.NVD.TagsHint}"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Margin="0,0,0,16"
                       MaxLength="200"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,24,0,0">
            <Button Content="{DynamicResource Loc.Dlg.Cancel}"
                  Style="{StaticResource MaterialDesignOutlinedButton}"
                  Margin="0,0,12,0"
                  Width="80"
                  Click="Cancel_Click"/>
            <Button Content="{DynamicResource Loc.Dlg.Create}"
                  Style="{StaticResource MaterialDesignRaisedButton}"
                  Width="80"
                  Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
