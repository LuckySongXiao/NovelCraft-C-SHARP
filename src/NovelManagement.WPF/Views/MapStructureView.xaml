<UserControl x:Class="NovelManagement.WPF.Views.MapStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryHueMidBrush}" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Map" 
                                           Foreground="White" 
                                           Width="32" 
                                           Height="32" 
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Loc.WS.Map.Title}" 
                             Foreground="White" 
                             FontSize="24" 
                             FontWeight="Medium" 
                             VerticalAlignment="Center" 
                             Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="AddMap_Click"
                            ToolTip="{DynamicResource Loc.WS.Map.NewTooltip}">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="ImportMap_Click"
                            ToolTip="{DynamicResource Loc.WS.Map.ImportTooltip}">
                        <materialDesign:PackIcon Kind="Import" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="ExportMap_Click"
                            ToolTip="{DynamicResource Loc.WS.Map.ExportTooltip}">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="AIAssistant_Click"
                            ToolTip="{DynamicResource Loc.WS.Common.AIAssistant}">
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：地图列表 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Padding="16,16,16,8">
                        <TextBox x:Name="SearchTextBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.SearchHint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="SearchTextBox_TextChanged"/>
                    </Border>

                    <!-- 筛选器 -->
                    <Border Grid.Row="1" Padding="16,0,16,8">
                        <StackPanel>
                            <ComboBox x:Name="MapLevelFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.LevelHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="MapLevelFilter_SelectionChanged"
                                     Margin="0,0,0,8">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllLevels}"/>
                                <ComboBoxItem Tag="世界地图" Content="{DynamicResource Loc.WS.Map.Data.世界地图}"/>
                                <ComboBoxItem Tag="大陆地图" Content="{DynamicResource Loc.WS.Map.Data.大陆地图}"/>
                                <ComboBoxItem Tag="区域地图" Content="{DynamicResource Loc.WS.Map.Data.区域地图}"/>
                                <ComboBoxItem Tag="城市地图" Content="{DynamicResource Loc.WS.Map.Data.城市地图}"/>
                                <ComboBoxItem Tag="建筑地图" Content="{DynamicResource Loc.WS.Map.Data.建筑地图}"/>
                            </ComboBox>
                            <ComboBox x:Name="TerrainFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.TerrainHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="TerrainFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllTerrains}"/>
                                <ComboBoxItem Tag="平原" Content="{DynamicResource Loc.WS.Map.Data.平原}"/>
                                <ComboBoxItem Tag="山脉" Content="{DynamicResource Loc.WS.Map.Data.山脉}"/>
                                <ComboBoxItem Tag="森林" Content="{DynamicResource Loc.WS.Map.Data.森林}"/>
                                <ComboBoxItem Tag="沙漠" Content="{DynamicResource Loc.WS.Map.Data.沙漠}"/>
                                <ComboBoxItem Tag="海洋" Content="{DynamicResource Loc.WS.Map.Data.海洋}"/>
                                <ComboBoxItem Tag="湖泊" Content="{DynamicResource Loc.WS.Map.Data.湖泊}"/>
                                <ComboBoxItem Tag="冰原" Content="{DynamicResource Loc.WS.Map.Data.冰原}"/>
                                <ComboBoxItem Tag="火山" Content="{DynamicResource Loc.WS.Map.Data.火山}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 地图列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MapListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                       Kind="Map" 
                                                                       Width="20" 
                                                                       Height="20" 
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>

                                                <Border Grid.Column="2" 
                                                      Background="{DynamicResource PrimaryHueLightBrush}"
                                                      CornerRadius="8"
                                                      Padding="6,2">
                                                    <TextBlock Text="{Binding Level}" 
                                                             Foreground="White" 
                                                             FontSize="10"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" 
                                                     Text="{Binding Description}" 
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     FontSize="12"
                                                     Margin="28,4,0,0"
                                                     TextWrapping="Wrap"/>

                                            <StackPanel Grid.Row="2" 
                                                      Orientation="Horizontal" 
                                                      Margin="28,4,0,0">
                                                <TextBlock Text="{DynamicResource Loc.WS.Map.TerrainLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="{Binding TerrainType}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                                <TextBlock Text="{DynamicResource Loc.WS.Map.ClimateLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding ClimateType}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 统计信息 -->
                    <Border Grid.Row="3" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.WS.Map.Stats}" 
                                     FontWeight="Medium" 
                                     FontSize="12" 
                                     Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Common.TotalLabel}"/>
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.世界地图}"/>
                                        <Run Text="{Binding WorldMapCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.区域地图}"/>
                                        <Run Text="{Binding RegionMapCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.城市地图}"/>
                                        <Run Text="{Binding CityMapCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 右侧：地图详情编辑区域 -->
            <materialDesign:Card Grid.Column="1" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="24">
                        <!-- 默认提示 -->
                        <StackPanel x:Name="EmptyStatePanel" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Visibility="Visible">
                            <materialDesign:PackIcon Kind="MapOutline" 
                                                   Width="64" 
                                                   Height="64" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Map.NoSelection}" 
                                     FontSize="16" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Map.NoSelectionHint}" 
                                     FontSize="14" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 地图详情编辑面板 -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <!-- 基本信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Common.BasicInfo}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="MapNameTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.NameHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="MapLevelComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.LevelHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="世界地图" Content="{DynamicResource Loc.WS.Map.Data.世界地图}"/>
                                    <ComboBoxItem Tag="大陆地图" Content="{DynamicResource Loc.WS.Map.Data.大陆地图}"/>
                                    <ComboBoxItem Tag="区域地图" Content="{DynamicResource Loc.WS.Map.Data.区域地图}"/>
                                    <ComboBoxItem Tag="城市地图" Content="{DynamicResource Loc.WS.Map.Data.城市地图}"/>
                                    <ComboBoxItem Tag="建筑地图" Content="{DynamicResource Loc.WS.Map.Data.建筑地图}"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                         x:Name="TerrainTypeComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.MainTerrainHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="平原" Content="{DynamicResource Loc.WS.Map.Data.平原}"/>
                                    <ComboBoxItem Tag="山脉" Content="{DynamicResource Loc.WS.Map.Data.山脉}"/>
                                    <ComboBoxItem Tag="森林" Content="{DynamicResource Loc.WS.Map.Data.森林}"/>
                                    <ComboBoxItem Tag="沙漠" Content="{DynamicResource Loc.WS.Map.Data.沙漠}"/>
                                    <ComboBoxItem Tag="海洋" Content="{DynamicResource Loc.WS.Map.Data.海洋}"/>
                                    <ComboBoxItem Tag="湖泊" Content="{DynamicResource Loc.WS.Map.Data.湖泊}"/>
                                    <ComboBoxItem Tag="冰原" Content="{DynamicResource Loc.WS.Map.Data.冰原}"/>
                                    <ComboBoxItem Tag="火山" Content="{DynamicResource Loc.WS.Map.Data.火山}"/>
                                    <ComboBoxItem Tag="混合地形" Content="{DynamicResource Loc.WS.Map.Data.混合地形}"/>
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                         x:Name="ClimateTypeComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.ClimateTypeHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="温带" Content="{DynamicResource Loc.WS.Map.Data.温带}"/>
                                    <ComboBoxItem Tag="热带" Content="{DynamicResource Loc.WS.Map.Data.热带}"/>
                                    <ComboBoxItem Tag="寒带" Content="{DynamicResource Loc.WS.Map.Data.寒带}"/>
                                    <ComboBoxItem Tag="亚热带" Content="{DynamicResource Loc.WS.Map.Data.亚热带}"/>
                                    <ComboBoxItem Tag="干旱" Content="{DynamicResource Loc.WS.Map.Data.干旱}"/>
                                    <ComboBoxItem Tag="湿润" Content="{DynamicResource Loc.WS.Map.Data.湿润}"/>
                                    <ComboBoxItem Tag="高原" Content="{DynamicResource Loc.WS.Map.Data.高原}"/>
                                    <ComboBoxItem Tag="海洋性" Content="{DynamicResource Loc.WS.Map.Data.海洋性}"/>
                                    <ComboBoxItem Tag="大陆性" Content="{DynamicResource Loc.WS.Map.Data.大陆性}"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="DimensionIdTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.DimensionHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Column="2"
                                        x:Name="ParentMapTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.ParentMapHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>
                            </Grid>

                            <TextBox x:Name="MapDescriptionTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.DescHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="3"
                                    MaxLines="5"
                                    Margin="0,0,0,24"/>

                            <!-- 地理信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Map.GeoTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="AreaSizeTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.AreaHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="CoordinatesTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.CoordinatesHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="ElevationTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.AltitudeHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="DangerLevelComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.DangerLevelHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Tag="安全" Content="{DynamicResource Loc.WS.Map.Data.安全}"/>
                                    <ComboBoxItem Tag="低危" Content="{DynamicResource Loc.WS.Map.Data.低危}"/>
                                    <ComboBoxItem Tag="中危" Content="{DynamicResource Loc.WS.Map.Data.中危}"/>
                                    <ComboBoxItem Tag="高危" Content="{DynamicResource Loc.WS.Map.Data.高危}"/>
                                    <ComboBoxItem Tag="极危" Content="{DynamicResource Loc.WS.Map.Data.极危}"/>
                                    <ComboBoxItem Tag="禁区" Content="{DynamicResource Loc.WS.Map.Data.禁区}"/>
                                </ComboBox>
                            </Grid>

                            <!-- 资源分布 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Map.ResourcesTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                  BorderThickness="1" 
                                  CornerRadius="4" 
                                  Padding="16"
                                  Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                 Text="{DynamicResource Loc.WS.Map.ResourceList}" 
                                                 FontWeight="Medium"/>
                                        
                                        <Button Grid.Column="1" 
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              Click="AddResource_Click"
                                              ToolTip="{DynamicResource Loc.WS.Map.AddResourceTooltip}">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="ResourceListControl" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                      BorderThickness="0,0,0,1" 
                                                      Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" 
                                                               Text="{Binding Name}" 
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.ResourceNameHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>
                                                        
                                                        <ComboBox Grid.Column="1" 
                                                                SelectedValuePath="Content"
                                                                SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" 
                                                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.ResourceTypeHint}"
                                                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                Margin="0,0,8,0">
                                                            <ComboBoxItem Tag="矿物" Content="{DynamicResource Loc.WS.Map.Data.矿物}"/>
                                                            <ComboBoxItem Tag="植物" Content="{DynamicResource Loc.WS.Map.Data.植物}"/>
                                                            <ComboBoxItem Tag="动物" Content="{DynamicResource Loc.WS.Map.Data.动物}"/>
                                                            <ComboBoxItem Tag="水源" Content="{DynamicResource Loc.WS.Map.Data.水源}"/>
                                                            <ComboBoxItem Tag="能量" Content="{DynamicResource Loc.WS.Map.Data.能量}"/>
                                                            <ComboBoxItem Tag="特殊" Content="{DynamicResource Loc.WS.Common.Data.特殊}"/>
                                                        </ComboBox>
                                                        
                                                        <ComboBox Grid.Column="2" 
                                                                SelectedValuePath="Content"
                                                                SelectedValue="{Binding Abundance, UpdateSourceTrigger=PropertyChanged}" 
                                                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Map.AbundanceHint}"
                                                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                Margin="0,0,8,0">
                                                            <ComboBoxItem Tag="稀有" Content="{DynamicResource Loc.WS.Map.Data.稀有}"/>
                                                            <ComboBoxItem Tag="少量" Content="{DynamicResource Loc.WS.Map.Data.少量}"/>
                                                            <ComboBoxItem Tag="普通" Content="{DynamicResource Loc.WS.Common.Data.普通}"/>
                                                            <ComboBoxItem Tag="丰富" Content="{DynamicResource Loc.WS.Map.Data.丰富}"/>
                                                            <ComboBoxItem Tag="极丰" Content="{DynamicResource Loc.WS.Map.Data.极丰}"/>
                                                        </ComboBox>

                                                        <Button Grid.Column="3" 
                                                              Style="{StaticResource MaterialDesignIconButton}"
                                                              Click="RemoveResource_Click"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="{DynamicResource Loc.WS.Map.DeleteResourceTooltip}">
                                                            <materialDesign:PackIcon Kind="Delete" 
                                                                                   Foreground="{DynamicResource ValidationErrorBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Right" 
                                      Margin="0,16,0,0">
                                <Button Content="{DynamicResource Loc.Dlg.Save}" 
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Click="SaveMap_Click"
                                      Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Loc.Dlg.Cancel}" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Click="CancelEdit_Click"
                                      Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
