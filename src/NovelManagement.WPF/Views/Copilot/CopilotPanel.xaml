<UserControl x:Class="NovelManagement.WPF.Views.Copilot.CopilotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:copilot="clr-namespace:NovelManagement.WPF.Views.Copilot"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="380"
             Background="{DynamicResource AppWindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 消息模板选择器：纯文本消息 vs 确认卡消息 -->
        <copilot:CopilotMessageTemplateSelector x:Key="MessageTemplateSelector">
            <copilot:CopilotMessageTemplateSelector.TextTemplate>
                <DataTemplate>
                    <Grid Margin="4,4,4,4">
                        <!-- 用户消息：右侧主色气泡 -->
                        <Border MaxWidth="300"
                                HorizontalAlignment="Right"
                                CornerRadius="10"
                                Padding="10,7"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Visibility="{Binding Role, Converter={copilot:RoleToVisibilityConverter Param=User}}">
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       Foreground="White"/>
                        </Border>

                        <!-- 助手消息：左侧卡片气泡 -->
                        <Border MaxWidth="320"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="10,7"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                Visibility="{Binding Role, Converter={copilot:RoleToVisibilityConverter Param=Assistant}}">
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Border>

                        <!-- 系统提示：居中浅色小字 -->
                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="320"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Visibility="{Binding Role, Converter={copilot:RoleToVisibilityConverter Param=System}}"/>
                    </Grid>
                </DataTemplate>
            </copilot:CopilotMessageTemplateSelector.TextTemplate>

            <copilot:CopilotMessageTemplateSelector.ProposalTemplate>
                <DataTemplate>
                    <Border Margin="4,6,4,6"
                            CornerRadius="10"
                            Padding="12"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <!-- 卡头：标题 + 整卡状态 -->
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="{Binding Proposal.Title}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Proposal.Summary}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,4"
                                       FontSize="12"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                            <!-- 整卡非 Pending 状态徽标 -->
                            <TextBlock Margin="0,0,0,4"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Text="{Binding Proposal.Status, Converter={copilot:ProposalStatusTextConverter CardMode=True}}"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Proposal.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 待采纳项列表 -->
                            <ItemsControl ItemsSource="{Binding Proposal.Items}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4,0,4"
                                                CornerRadius="6"
                                                Padding="8"
                                                Background="{DynamicResource AppWindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Medium"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    <!-- 项状态徽标（Pending 时隐藏） -->
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Text="{Binding Status, Converter={copilot:ProposalStatusTextConverter CardMode=False}}"
                                                               Foreground="{DynamicResource PrimaryHueMidBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Text="{Binding DisplayBody}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,4"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MaterialDesignBody}"/>

                                                <!-- 单项操作按钮（仅 Pending 可见） -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                    <Button Content="采纳"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            FontSize="11"
                                                            Click="AcceptItem_Click"/>
                                                    <Button Content="修改"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            FontSize="11"
                                                            Click="EditItem_Click"/>
                                                    <Button Content="放弃"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Click="RejectItem_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 整卡操作（仅整卡 Pending 时可见） -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding Proposal.Status, Converter={copilot:PendingToVisibilityConverter}}">
                                <Button Content="全部采纳"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Click="AcceptAll_Click"/>
                                <Button Content="放弃整卡"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="12,4"
                                        Click="RejectCard_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </copilot:CopilotMessageTemplateSelector.ProposalTemplate>
        </copilot:CopilotMessageTemplateSelector>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 流水线阶段 + 收起 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,10,8,10">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignToolButton}"
                        ToolTip="收起 AI 创作助手"
                        Click="ClosePanel_Click">
                    <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20"/>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Robot"
                                             Width="22" Height="22"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI 创作助手" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="StageBadgeText"
                                   Text="流水线：未开始"
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 消息流 -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Margin="4,4,4,0">
            <ItemsControl x:Name="MessageItemsControl"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}"/>
        </ScrollViewer>

        <!-- 章节关联提示条（已关联目标章节时显示） -->
        <Border Grid.Row="2"
                x:Name="ChapterRefBanner"
                Visibility="Collapsed"
                Margin="8,6,8,0"
                CornerRadius="6"
                Padding="10,6"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="ClearChapterRefButton"
                        Style="{StaticResource MaterialDesignToolButton}"
                        ToolTip="取消章节关联"
                        Click="ClearChapterRef_Click">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock x:Name="ChapterRefText"
                               FontSize="11"
                               VerticalAlignment="Center"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 修改模式提示条 -->
        <Border Grid.Row="3"
                x:Name="EditBanner"
                Visibility="Collapsed"
                Margin="8,6,8,0"
                CornerRadius="6"
                Padding="10,6"
                Background="{DynamicResource PrimaryHueLightBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Content="取消"
                        FontSize="11"
                        Click="CancelEdit_Click"/>
                <TextBlock Text="修改模式：直接输入修改后的内容，发送后生效"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- 输入区 -->
        <DockPanel Grid.Row="4" Margin="8,8,8,10">
            <Button DockPanel.Dock="Left"
                    x:Name="AttachChapterButton"
                    Style="{StaticResource MaterialDesignToolButton}"
                    Margin="0,0,4,0"
                    ToolTip="关联章节（书 → 卷 → 章），关联后直接输入要求处理该章"
                    Click="AttachChapter_Click">
                <materialDesign:PackIcon Kind="LinkVariant" Width="20" Height="20"/>
            </Button>
            <Button DockPanel.Dock="Right"
                    x:Name="SendButton"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="8,0,0,0"
                    ToolTip="发送（Enter）"
                    Click="Send_Click">
                <materialDesign:PackIcon Kind="Send" Width="20" Height="20"/>
            </Button>
            <TextBox x:Name="InputTextBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     VerticalContentAlignment="Center"
                     TextWrapping="Wrap"
                     MaxLines="4"
                     KeyDown="InputTextBox_KeyDown"/>
        </DockPanel>
    </Grid>
</UserControl>
