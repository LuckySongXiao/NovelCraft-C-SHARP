<UserControl x:Class="NovelManagement.WPF.Views.DimensionStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryHueMidBrush}" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CubeOutline" 
                                           Foreground="White" 
                                           Width="32" 
                                           Height="32" 
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Loc.WS.Dim.Title}" 
                             Foreground="White" 
                             FontSize="24" 
                             FontWeight="Medium" 
                             VerticalAlignment="Center" 
                             Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="AddDimension_Click"
                            ToolTip="{DynamicResource Loc.WS.Dim.NewTooltip}">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="ImportDimension_Click"
                            ToolTip="{DynamicResource Loc.WS.Dim.ImportTooltip}">
                        <materialDesign:PackIcon Kind="Import" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="ExportDimension_Click"
                            ToolTip="{DynamicResource Loc.WS.Dim.ExportTooltip}">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="AIAssistant_Click"
                            ToolTip="{DynamicResource Loc.WS.Common.AIAssistant}">
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：维度列表 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Padding="16,16,16,8">
                        <TextBox x:Name="SearchTextBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.SearchHint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="SearchTextBox_TextChanged"/>
                    </Border>

                    <!-- 筛选器 -->
                    <Border Grid.Row="1" Padding="16,0,16,8">
                        <StackPanel>
                            <ComboBox x:Name="DimensionTypeFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.TypeHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="DimensionTypeFilter_SelectionChanged"
                                     Margin="0,0,0,8">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllTypes}"/>
                                <ComboBoxItem Tag="物质维度" Content="{DynamicResource Loc.WS.Dim.Data.物质维度}"/>
                                <ComboBoxItem Tag="精神维度" Content="{DynamicResource Loc.WS.Dim.Data.精神维度}"/>
                                <ComboBoxItem Tag="能量维度" Content="{DynamicResource Loc.WS.Dim.Data.能量维度}"/>
                                <ComboBoxItem Tag="时间维度" Content="{DynamicResource Loc.WS.Dim.Data.时间维度}"/>
                                <ComboBoxItem Tag="空间维度" Content="{DynamicResource Loc.WS.Dim.Data.空间维度}"/>
                                <ComboBoxItem Tag="混合维度" Content="{DynamicResource Loc.WS.Dim.Data.混合维度}"/>
                            </ComboBox>
                            <ComboBox x:Name="StabilityFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.StabilityHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="StabilityFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllStabilities}"/>
                                <ComboBoxItem Tag="极稳定" Content="{DynamicResource Loc.WS.Dim.Data.极稳定}"/>
                                <ComboBoxItem Tag="稳定" Content="{DynamicResource Loc.WS.Dim.Data.稳定}"/>
                                <ComboBoxItem Tag="不稳定" Content="{DynamicResource Loc.WS.Dim.Data.不稳定}"/>
                                <ComboBoxItem Tag="极不稳定" Content="{DynamicResource Loc.WS.Dim.Data.极不稳定}"/>
                                <ComboBoxItem Tag="崩塌中" Content="{DynamicResource Loc.WS.Dim.Data.崩塌中}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 维度列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DimensionListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectDimensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                       Kind="CubeOutline" 
                                                                       Width="20" 
                                                                       Height="20" 
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>

                                                <Border Grid.Column="2" 
                                                      Background="{DynamicResource PrimaryHueLightBrush}"
                                                      CornerRadius="8"
                                                      Padding="6,2">
                                                    <TextBlock Text="{Binding Stability}" 
                                                             Foreground="White" 
                                                             FontSize="10"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" 
                                                     Text="{Binding Description}" 
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     FontSize="12"
                                                     Margin="28,4,0,0"
                                                     TextWrapping="Wrap"/>

                                            <StackPanel Grid.Row="2" 
                                                      Orientation="Horizontal" 
                                                      Margin="28,4,0,0">
                                                <TextBlock Text="{DynamicResource Loc.WS.Trea.TypeLabelDup}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="{Binding Type}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                                <TextBlock Text="{DynamicResource Loc.WS.Dim.AccessLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding AccessLevel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 统计信息 -->
                    <Border Grid.Row="3" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.WS.Dim.Stats}" 
                                     FontWeight="Medium" 
                                     FontSize="12" 
                                     Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Common.TotalLabel}"/>
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.物质维度}"/>
                                        <Run Text="{Binding MaterialCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.精神维度}"/>
                                        <Run Text="{Binding SpiritualCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Dim.StableCountLabel}"/>
                                        <Run Text="{Binding StableCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 右侧：维度详情编辑区域 -->
            <materialDesign:Card Grid.Column="1" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="24">
                        <!-- 默认提示 -->
                        <StackPanel x:Name="EmptyStatePanel" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Visibility="Visible">
                            <materialDesign:PackIcon Kind="CubeOutline" 
                                                   Width="64" 
                                                   Height="64" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Dim.NoSelection}" 
                                     FontSize="16" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Dim.NoSelectionHint}" 
                                     FontSize="14" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 维度详情编辑面板 -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <!-- 基本信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Common.BasicInfo}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="DimensionNameTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.NameHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="DimensionTypeComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.TypeHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="物质维度" Content="{DynamicResource Loc.WS.Dim.Data.物质维度}"/>
                                    <ComboBoxItem Tag="精神维度" Content="{DynamicResource Loc.WS.Dim.Data.精神维度}"/>
                                    <ComboBoxItem Tag="能量维度" Content="{DynamicResource Loc.WS.Dim.Data.能量维度}"/>
                                    <ComboBoxItem Tag="时间维度" Content="{DynamicResource Loc.WS.Dim.Data.时间维度}"/>
                                    <ComboBoxItem Tag="空间维度" Content="{DynamicResource Loc.WS.Dim.Data.空间维度}"/>
                                    <ComboBoxItem Tag="混合维度" Content="{DynamicResource Loc.WS.Dim.Data.混合维度}"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                         x:Name="StabilityComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.StabilityHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="极稳定" Content="{DynamicResource Loc.WS.Dim.Data.极稳定}"/>
                                    <ComboBoxItem Tag="稳定" Content="{DynamicResource Loc.WS.Dim.Data.稳定}"/>
                                    <ComboBoxItem Tag="不稳定" Content="{DynamicResource Loc.WS.Dim.Data.不稳定}"/>
                                    <ComboBoxItem Tag="极不稳定" Content="{DynamicResource Loc.WS.Dim.Data.极不稳定}"/>
                                    <ComboBoxItem Tag="崩塌中" Content="{DynamicResource Loc.WS.Dim.Data.崩塌中}"/>
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                         x:Name="AccessLevelComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.AccessHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="公开" Content="{DynamicResource Loc.WS.Dim.Data.公开}"/>
                                    <ComboBoxItem Tag="限制" Content="{DynamicResource Loc.WS.Dim.Data.限制}"/>
                                    <ComboBoxItem Tag="机密" Content="{DynamicResource Loc.WS.Dim.Data.机密}"/>
                                    <ComboBoxItem Tag="禁止" Content="{DynamicResource Loc.WS.Dim.Data.禁止}"/>
                                    <ComboBoxItem Tag="未知" Content="{DynamicResource Loc.WS.Dim.Data.未知}"/>
                                </ComboBox>
                            </Grid>

                            <TextBox x:Name="DimensionDescriptionTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.DescHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="3"
                                    MaxLines="5"
                                    Margin="0,0,0,24"/>

                            <!-- 环境特征 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Dim.EnvTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="EnvironmentTypeTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.EnvTypeHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="ClimateTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.ClimateHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="EnergyLevelTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.EnergyLevelHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="DangerLevelTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.DangerLevelHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <!-- 连接传送 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Dim.PortalsTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                  BorderThickness="1" 
                                  CornerRadius="4" 
                                  Padding="16"
                                  Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                 Text="{DynamicResource Loc.WS.Dim.PortalList}" 
                                                 FontWeight="Medium"/>
                                        
                                        <Button Grid.Column="1" 
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              Click="AddPortal_Click"
                                              ToolTip="{DynamicResource Loc.WS.Dim.AddPortalTooltip}">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="PortalListControl" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                      BorderThickness="0,0,0,1" 
                                                      Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" 
                                                               Text="{Binding Name}" 
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.PortalNameHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>
                                                        
                                                        <TextBox Grid.Column="1" 
                                                               Text="{Binding TargetDimension}" 
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Dim.TargetDimHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>
                                                        
                                                        <ComboBox Grid.Column="2" 
                                                                SelectedValuePath="Content"
                                                                SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" 
                                                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Common.StatusHint}"
                                                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                Margin="0,0,8,0">
                                                            <ComboBoxItem Tag="正常" Content="{DynamicResource Loc.WS.Dim.Data.正常}"/>
                                                            <ComboBoxItem Tag="不稳定" Content="{DynamicResource Loc.WS.Dim.Data.不稳定}"/>
                                                            <ComboBoxItem Tag="关闭" Content="{DynamicResource Loc.WS.Dim.Data.关闭}"/>
                                                            <ComboBoxItem Tag="损坏" Content="{DynamicResource Loc.WS.Dim.Data.损坏}"/>
                                                        </ComboBox>

                                                        <Button Grid.Column="3" 
                                                              Style="{StaticResource MaterialDesignIconButton}"
                                                              Click="RemovePortal_Click"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="{DynamicResource Loc.WS.Dim.DeletePortalTooltip}">
                                                            <materialDesign:PackIcon Kind="Delete" 
                                                                                   Foreground="{DynamicResource ValidationErrorBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Right" 
                                      Margin="0,16,0,0">
                                <Button Content="{DynamicResource Loc.Dlg.Save}" 
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Click="SaveDimension_Click"
                                      Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Loc.Dlg.Cancel}" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Click="CancelEdit_Click"
                                      Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
