<UserControl x:Class="NovelManagement.WPF.Views.PetSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryHueMidBrush}" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PawOutline" 
                                           Foreground="White" 
                                           Width="32" 
                                           Height="32" 
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Loc.WS.Pet.Title}" 
                             Foreground="White" 
                             FontSize="24" 
                             FontWeight="Medium" 
                             VerticalAlignment="Center" 
                             Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="AddPet_Click"
                            ToolTip="{DynamicResource Loc.WS.Pet.NewTooltip}">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="ImportPet_Click"
                            ToolTip="{DynamicResource Loc.WS.Pet.ImportTooltip}">
                        <materialDesign:PackIcon Kind="Import" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="ExportPet_Click"
                            ToolTip="{DynamicResource Loc.WS.Pet.ExportTooltip}">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="AIAssistant_Click"
                            ToolTip="{DynamicResource Loc.WS.Common.AIAssistant}">
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：宠物列表 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Padding="16,16,16,8">
                        <TextBox x:Name="SearchTextBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.SearchHint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="SearchTextBox_TextChanged"/>
                    </Border>

                    <!-- 筛选器 -->
                    <Border Grid.Row="1" Padding="16,0,16,8">
                        <StackPanel>
                            <ComboBox x:Name="PetTypeFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.TypeHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="PetTypeFilter_SelectionChanged"
                                     Margin="0,0,0,8">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllTypes}"/>
                                <ComboBoxItem Tag="灵兽" Content="{DynamicResource Loc.WS.Pet.Data.灵兽}"/>
                                <ComboBoxItem Tag="妖兽" Content="{DynamicResource Loc.WS.Pet.Data.妖兽}"/>
                                <ComboBoxItem Tag="神兽" Content="{DynamicResource Loc.WS.Pet.Data.神兽}"/>
                                <ComboBoxItem Tag="魔兽" Content="{DynamicResource Loc.WS.Pet.Data.魔兽}"/>
                                <ComboBoxItem Tag="仙兽" Content="{DynamicResource Loc.WS.Pet.Data.仙兽}"/>
                                <ComboBoxItem Tag="凶兽" Content="{DynamicResource Loc.WS.Pet.Data.凶兽}"/>
                                <ComboBoxItem Tag="异兽" Content="{DynamicResource Loc.WS.Pet.Data.异兽}"/>
                            </ComboBox>
                            <ComboBox x:Name="RarityFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.RarityHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="RarityFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllRarities}"/>
                                <ComboBoxItem Tag="普通" Content="{DynamicResource Loc.WS.Common.Data.普通}"/>
                                <ComboBoxItem Tag="稀有" Content="{DynamicResource Loc.WS.Map.Data.稀有}"/>
                                <ComboBoxItem Tag="史诗" Content="{DynamicResource Loc.WS.Pet.Data.史诗}"/>
                                <ComboBoxItem Tag="传说" Content="{DynamicResource Loc.WS.Trea.Data.传说}"/>
                                <ComboBoxItem Tag="神话" Content="{DynamicResource Loc.WS.Pet.Data.神话}"/>
                                <ComboBoxItem Tag="至尊" Content="{DynamicResource Loc.WS.Pet.Data.至尊}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 宠物列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PetListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectPetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                       Kind="PawOutline" 
                                                                       Width="20" 
                                                                       Height="20" 
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>

                                                <Border Grid.Column="2" 
                                                      Background="{DynamicResource PrimaryHueLightBrush}"
                                                      CornerRadius="8"
                                                      Padding="6,2">
                                                    <TextBlock Text="{Binding Rarity}" 
                                                             Foreground="White" 
                                                             FontSize="10"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" 
                                                     Text="{Binding Description}" 
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     FontSize="12"
                                                     Margin="28,4,0,0"
                                                     TextWrapping="Wrap"/>

                                            <StackPanel Grid.Row="2" 
                                                      Orientation="Horizontal" 
                                                      Margin="28,4,0,0">
                                                <TextBlock Text="{DynamicResource Loc.WS.Trea.TypeLabelDup}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="{Binding Type}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                                <TextBlock Text="{DynamicResource Loc.WS.Pet.LevelLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Level}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 统计信息 -->
                    <Border Grid.Row="3" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.WS.Pet.Stats}" 
                                     FontWeight="Medium" 
                                     FontSize="12" 
                                     Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Common.TotalLabel}"/>
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.灵兽}"/>
                                        <Run Text="{Binding SpiritBeastCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.神兽}"/>
                                        <Run Text="{Binding DivineBeastCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Pet.LegendaryLabel}"/>
                                        <Run Text="{Binding LegendaryCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 右侧：宠物详情编辑区域 -->
            <materialDesign:Card Grid.Column="1" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="24">
                        <!-- 默认提示 -->
                        <StackPanel x:Name="EmptyStatePanel" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Visibility="Visible">
                            <materialDesign:PackIcon Kind="PawOutline" 
                                                   Width="64" 
                                                   Height="64" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Pet.NoSelection}" 
                                     FontSize="16" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Pet.NoSelectionHint}" 
                                     FontSize="14" 
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center" 
                                     Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 宠物详情编辑面板 -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <!-- 基本信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Common.BasicInfo}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="PetNameTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.NameHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="PetTypeComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.TypeHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="灵兽" Content="{DynamicResource Loc.WS.Pet.Data.灵兽}"/>
                                    <ComboBoxItem Tag="妖兽" Content="{DynamicResource Loc.WS.Pet.Data.妖兽}"/>
                                    <ComboBoxItem Tag="神兽" Content="{DynamicResource Loc.WS.Pet.Data.神兽}"/>
                                    <ComboBoxItem Tag="魔兽" Content="{DynamicResource Loc.WS.Pet.Data.魔兽}"/>
                                    <ComboBoxItem Tag="仙兽" Content="{DynamicResource Loc.WS.Pet.Data.仙兽}"/>
                                    <ComboBoxItem Tag="凶兽" Content="{DynamicResource Loc.WS.Pet.Data.凶兽}"/>
                                    <ComboBoxItem Tag="异兽" Content="{DynamicResource Loc.WS.Pet.Data.异兽}"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                         x:Name="RarityComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.RarityHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="普通" Content="{DynamicResource Loc.WS.Common.Data.普通}"/>
                                    <ComboBoxItem Tag="稀有" Content="{DynamicResource Loc.WS.Map.Data.稀有}"/>
                                    <ComboBoxItem Tag="史诗" Content="{DynamicResource Loc.WS.Pet.Data.史诗}"/>
                                    <ComboBoxItem Tag="传说" Content="{DynamicResource Loc.WS.Trea.Data.传说}"/>
                                    <ComboBoxItem Tag="神话" Content="{DynamicResource Loc.WS.Pet.Data.神话}"/>
                                    <ComboBoxItem Tag="至尊" Content="{DynamicResource Loc.WS.Pet.Data.至尊}"/>
                                </ComboBox>

                                <TextBox Grid.Column="2"
                                        x:Name="LevelTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Common.LevelHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="ElementTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.ElementHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="GrowthStageComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.StageHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="幼体" Content="{DynamicResource Loc.WS.Pet.Data.幼体}"/>
                                    <ComboBoxItem Tag="成长期" Content="{DynamicResource Loc.WS.Pet.Data.成长期}"/>
                                    <ComboBoxItem Tag="成熟期" Content="{DynamicResource Loc.WS.Pet.Data.成熟期}"/>
                                    <ComboBoxItem Tag="完全体" Content="{DynamicResource Loc.WS.Pet.Data.完全体}"/>
                                    <ComboBoxItem Tag="究极体" Content="{DynamicResource Loc.WS.Pet.Data.究极体}"/>
                                </ComboBox>
                            </Grid>

                            <TextBox x:Name="PetDescriptionTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.DescHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="3"
                                    MaxLines="5"
                                    Margin="0,0,0,24"/>

                            <!-- 属性信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Pet.AttrTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="AttackTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.ATKHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="DefenseTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.DEFHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="4"
                                        x:Name="HealthTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.HPHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="SpeedTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.SpeedHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="ManaTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.MPHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="4"
                                        x:Name="LoyaltyTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.LoyaltyHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <!-- 技能系统 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Pet.SkillsTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                  BorderThickness="1" 
                                  CornerRadius="4" 
                                  Padding="16"
                                  Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                 Text="{DynamicResource Loc.WS.Pet.SkillList}" 
                                                 FontWeight="Medium"/>
                                        
                                        <Button Grid.Column="1" 
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              Click="AddSkill_Click"
                                              ToolTip="{DynamicResource Loc.WS.Pet.AddSkillTooltip}">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="SkillListControl" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                      BorderThickness="0,0,0,1" 
                                                      Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" 
                                                               Text="{Binding Name}" 
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.SkillNameHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>
                                                        
                                                        <ComboBox Grid.Column="1" 
                                                                SelectedItem="{Binding Type}" 
                                                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.SkillTypeHint}"
                                                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                Margin="0,0,8,0">
                                                            <ComboBoxItem Tag="攻击" Content="{DynamicResource Loc.WS.Pet.Data.攻击}"/>
                                                            <ComboBoxItem Tag="防御" Content="{DynamicResource Loc.WS.Pet.Data.防御}"/>
                                                            <ComboBoxItem Tag="治疗" Content="{DynamicResource Loc.WS.Pet.Data.治疗}"/>
                                                            <ComboBoxItem Tag="辅助" Content="{DynamicResource Loc.WS.Pet.Data.辅助}"/>
                                                            <ComboBoxItem Tag="特殊" Content="{DynamicResource Loc.WS.Common.Data.特殊}"/>
                                                        </ComboBox>
                                                        
                                                        <TextBox Grid.Column="2" 
                                                               Text="{Binding Level}" 
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.SkillLevelHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <Button Grid.Column="3" 
                                                              Style="{StaticResource MaterialDesignIconButton}"
                                                              Click="RemoveSkill_Click"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="{DynamicResource Loc.WS.Pet.DeleteSkillTooltip}">
                                                            <materialDesign:PackIcon Kind="Delete" 
                                                                                   Foreground="{DynamicResource ValidationErrorBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 进化信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Pet.EvolutionTitle}" 
                                     FontSize="18" 
                                     FontWeight="Medium" 
                                     Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="EvolutionFromTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.PreEvoHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2"
                                        x:Name="EvolutionToTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.PostEvoHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <TextBox x:Name="EvolutionConditionTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Pet.EvoCondHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="2"
                                    MaxLines="4"
                                    Margin="0,0,0,24"/>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Right" 
                                      Margin="0,16,0,0">
                                <Button Content="{DynamicResource Loc.Dlg.Save}" 
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Click="SavePet_Click"
                                      Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Loc.Dlg.Cancel}" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Click="CancelEdit_Click"
                                      Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
