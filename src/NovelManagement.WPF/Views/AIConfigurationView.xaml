<UserControl x:Class="NovelManagement.WPF.Views.AIConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <Style x:Key="ConfigCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        </Style>
        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>

        <Style x:Key="InfoTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Style="{StaticResource ConfigCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc.Nav.AIConfiguration}" Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                    <TextBlock Text="{DynamicResource Loc.AICfg.Subtitle}"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.68"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TestConnectionButton"
                            Content="{DynamicResource Loc.AICfg.TestConnection}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="8,0"
                            Click="TestConnectionButton_Click"/>
                    <Button x:Name="SaveConfigButton"
                            Content="{DynamicResource Loc.AICfg.SaveConfig}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="SaveConfigButton_Click"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">

                <materialDesign:Card Style="{StaticResource ConfigCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Loc.AICfg.RecommendedOrder}" Style="{StaticResource InfoTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.Step1}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.Step2}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.Step3}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Loc.AICfg.UsageTips}" Style="{StaticResource InfoTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.TipMainAgentCloud}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.TipSubAgentLocal}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.TipReleaseDir}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Loc.AICfg.ConfigFileLocation}" Style="{StaticResource InfoTitleStyle}"/>
                            <TextBlock x:Name="ConfigPathTextBlock"
                                       Text="{DynamicResource Loc.AICfg.LoadingDots}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="{DynamicResource Loc.AICfg.SaveEffectiveNote}"
                                       Margin="0,8,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
                
                <!-- Provider Selection -->
                <materialDesign:Card Style="{StaticResource ConfigCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.AICfg.DefaultProvider}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DefaultProviderComboBox"
                                      Grid.Column="0"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintDefaultDecisionProvider}"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      SelectionChanged="DefaultProviderComboBox_SelectionChanged"
                                      Margin="0,0,8,0">
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderLlamaCpp}" Tag="LlamaCpp"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderOllama}" Tag="Ollama"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderZhipuAI}" Tag="ZhipuAI"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderDeepSeek}" Tag="DeepSeek"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderXiaoMiMiMo}" Tag="XiaoMiMiMo"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderMCP}" Tag="MCP"/>
                            </ComboBox>
                            <ComboBox x:Name="DefaultCompletionProviderComboBox"
                                      Grid.Column="1"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintDefaultCompletionProvider}"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      SelectionChanged="DefaultCompletionProviderComboBox_SelectionChanged"
                                      Margin="8,0,0,0">
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderRWKV}" Tag="RWKV"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderLlamaCpp}" Tag="LlamaCpp"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderOllama}" Tag="Ollama"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderZhipuAI}" Tag="ZhipuAI"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderDeepSeek}" Tag="DeepSeek"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderXiaoMiMiMo}" Tag="XiaoMiMiMo"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource ConfigCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.AICfg.DualAgentTitle}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{DynamicResource Loc.AICfg.DualAgentDesc}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Opacity="0.68"
                                   Margin="0,0,0,12"/>

                        <CheckBox x:Name="EnableDualAgentWorkflowCheckBox"
                                  Content="{DynamicResource Loc.AICfg.EnableDualAgent}"
                                  IsChecked="True"
                                  Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="MainAgentProviderComboBox"
                                      Grid.Row="0" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMainAgentProvider}"
                                      Margin="0,0,8,8">
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderDeepSeekDense}" Tag="DeepSeek" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderZhipuAIOnly}" Tag="ZhipuAI"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderLlamaCppGguf}" Tag="LlamaCpp"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderOllamaShort}" Tag="Ollama"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderXiaoMi}" Tag="XiaoMiMiMo"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderRWKV}" Tag="RWKV"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderOpenAI}" Tag="OpenAI"/>
                            </ComboBox>

                            <TextBox x:Name="MainAgentModelTextBox"
                                     Grid.Row="0" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMainAgentModel}"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="MainAgentRoleDescriptionTextBox"
                                     Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMainAgentRole}"
                                     Text="{DynamicResource Loc.AICfg.MainAgentRoleText}"
                                     Margin="0,0,0,8"/>

                            <ComboBox x:Name="SubAgentProviderComboBox"
                                      Grid.Row="2" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintSubAgentProvider}"
                                      Margin="0,0,8,8">
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderLlamaCppMoe}" Tag="LlamaCpp" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderRWKV}" Tag="RWKV"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderOllamaShort}" Tag="Ollama"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderXiaoMi}" Tag="XiaoMiMiMo"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderZhipuAIOnly}" Tag="ZhipuAI"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderDeepSeekOnly}" Tag="DeepSeek"/>
                                <ComboBoxItem Content="{DynamicResource Loc.AICfg.ProviderOpenAI}" Tag="OpenAI"/>
                            </ComboBox>

                            <TextBox x:Name="SubAgentModelTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintSubAgentModel}"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="SubAgentRoleDescriptionTextBox"
                                     Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintSubAgentRole}"
                                     Text="{DynamicResource Loc.AICfg.SubAgentRoleText}"
                                     Margin="0,0,0,8"/>
                        </Grid>

                        <CheckBox x:Name="EnableArchiveWriteCheckBox"
                                  Content="{DynamicResource Loc.AICfg.AllowArchiveWrite}"
                                  IsChecked="True"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- RWKV Configuration -->
                <materialDesign:Card x:Name="RwkvConfigCard" Style="{StaticResource ConfigCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Loc.AICfg.RwkvTitle}" Style="{StaticResource SectionHeaderStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Circle"
                                                       x:Name="RwkvStatusIcon"
                                                       VerticalAlignment="Center"
                                                       Foreground="Gray"
                                                       Margin="0,0,4,0"/>
                                <TextBlock x:Name="RwkvStatusText"
                                         Text="{DynamicResource Loc.AICfg.StatusNotConfigured}"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Loc.AICfg.RwkvDesc}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Opacity="0.68" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="RwkvRefreshStatusButton"
                                    Content="{DynamicResource Loc.AICfg.RefreshStatus}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="RwkvRefreshStatusButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="RwkvStartRuntimeButton"
                                    Content="{DynamicResource Loc.AICfg.StartRuntime}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="RwkvStartRuntimeButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="RwkvStopRuntimeButton"
                                    Content="{DynamicResource Loc.AICfg.StopRuntime}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="RwkvStopRuntimeButton_Click"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="RwkvBaseUrlTextBox"
                                     Grid.Row="0" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintRwkvBaseUrl}"
                                     Text="http://localhost:8000"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="RwkvModelNameTextBox"
                                     Grid.Row="0" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintModelName}"
                                     Text="rwkv7-g1i"
                                     Margin="8,0,0,8"/>

                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="RwkvModelComboBox"
                                          Grid.Column="0"
                                          materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintSelectRwkvModel}"
                                          SelectionChanged="RwkvModelComboBox_SelectionChanged"/>
                                <Button x:Name="RwkvRefreshModelsButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Loc.AICfg.Scan}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="RwkvRefreshModelsButton_Click"
                                        Margin="8,0,0,0"/>
                            </Grid>

                            <ComboBox x:Name="RwkvStrategyComboBox"
                                      Grid.Row="1" Grid.Column="1"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintStrategy}"
                                      Margin="8,0,0,8">
                                <ComboBoxItem Content="cuda fp16" IsSelected="True"/>
                                <ComboBoxItem Content="cuda fp32"/>
                                <ComboBoxItem Content="web"/>
                            </ComboBox>

                            <TextBox x:Name="RwkvMaxTokensTextBox"
                                     Grid.Row="2" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMaxTokens}"
                                     Text="200"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="RwkvTemperatureTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintTemperature}"
                                     Text="1.0"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="RwkvTopPTextBox"
                                     Grid.Row="3" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintTopP}"
                                     Text="0.7"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="RwkvTopKTextBox"
                                     Grid.Row="3" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintTopK}"
                                     Text="50"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="RwkvFrequencyPenaltyTextBox"
                                     Grid.Row="4" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintFreqPenalty}"
                                     Text="0.0"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="RwkvPresencePenaltyTextBox"
                                     Grid.Row="4" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintPresencePenalty}"
                                     Text="0.0"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="RwkvTimeoutTextBox"
                                     Grid.Row="5" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintTimeoutSeconds}"
                                     Text="120"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="RwkvMaxRetriesTextBox"
                                     Grid.Row="5" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMaxRetries}"
                                     Text="3"
                                     Margin="8,0,0,8"/>
                        </Grid>

                        <!-- RWKV Server Settings -->
                        <Expander Header="{DynamicResource Loc.AICfg.ServerSettings}" Margin="0,8,0,0">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="RwkvAutoStartServerCheckBox"
                                          Grid.Row="0" Grid.Column="0"
                                          Content="{DynamicResource Loc.AICfg.AutoStartServer}"
                                          IsChecked="False"
                                          Margin="0,0,8,8"/>

                                <TextBox x:Name="RwkvGpuDeviceIdTextBox"
                                         Grid.Row="0" Grid.Column="1"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintGpuDeviceId}"
                                         Text="-1"
                                         Margin="8,0,0,8"/>

                                <TextBox x:Name="RwkvPythonPathTextBox"
                                         Grid.Row="1" Grid.Column="0"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintPythonPath}"
                                         Text="python"
                                         Margin="0,0,8,8"/>

                                <TextBox x:Name="RwkvServerScriptPathTextBox"
                                         Grid.Row="1" Grid.Column="1"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintRwkvExePath}"
                                         Margin="8,0,0,8"/>

                                <TextBox x:Name="RwkvContextSizeTextBox"
                                         Grid.Row="2" Grid.Column="0"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintContextSize}"
                                         Text="8192"
                                         Margin="0,0,8,8"/>

                                <TextBox x:Name="RwkvMaxConcurrentRequestsTextBox"
                                         Grid.Row="2" Grid.Column="1"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMaxConcurrent}"
                                         Text="20"
                                         Margin="8,0,0,8"/>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </materialDesign:Card>

                <!-- llama.cpp Configuration -->
                <materialDesign:Card x:Name="LlamaCppConfigCard" Style="{StaticResource ConfigCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Loc.AICfg.LlamaTitle}" Style="{StaticResource SectionHeaderStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Circle"
                                                       x:Name="LlamaStatusIcon"
                                                       VerticalAlignment="Center"
                                                       Foreground="Gray"
                                                       Margin="0,0,4,0"/>
                                <TextBlock x:Name="LlamaStatusText"
                                         Text="{DynamicResource Loc.AICfg.StatusNotConfigured}"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Loc.AICfg.LlamaDesc}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Opacity="0.68"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="LlamaRefreshStatusButton"
                                    Content="{DynamicResource Loc.AICfg.RefreshStatus}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="LlamaRefreshStatusButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="LlamaRefreshModelsButton"
                                    Content="{DynamicResource Loc.AICfg.ScanModels}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="LlamaRefreshModelsButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="StartLlamaRuntimeButton"
                                    Content="{DynamicResource Loc.AICfg.StartRuntime}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="StartLlamaRuntimeButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="StopLlamaRuntimeButton"
                                    Content="{DynamicResource Loc.AICfg.StopRuntime}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="StopLlamaRuntimeButton_Click"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="LlamaBackendComboBox"
                                      Grid.Row="0" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintLlamaBackend}"
                                      Margin="0,0,8,8"
                                      SelectionChanged="LlamaBackendComboBox_SelectionChanged">
                                <ComboBoxItem Content="CUDA" Tag="cuda" IsSelected="True"/>
                                <ComboBoxItem Content="CPU" Tag="cpu"/>
                                <ComboBoxItem Content="Vulkan" Tag="vulkan"/>
                                <ComboBoxItem Content="SYCL" Tag="sycl"/>
                            </ComboBox>

                            <TextBox x:Name="LlamaBaseUrlTextBox"
                                     Grid.Row="0" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintServerUrl}"
                                     Text="http://localhost:8081"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="LlamaExecutablePathTextBox"
                                     Grid.Row="1" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintLlamaExePath}"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="LlamaModelDirectoryTextBox"
                                     Grid.Row="1" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintGgufDir}"
                                     Margin="8,0,0,8"/>

                            <ComboBox x:Name="LlamaModelComboBox"
                                      Grid.Row="2" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintOnDemandModel}"
                                      Margin="0,0,8,8"
                                      SelectionChanged="LlamaModelComboBox_SelectionChanged"/>

                            <TextBox x:Name="LlamaMmprojPathTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintMmprojPath}"
                                     Margin="8,0,0,8"/>

                            <TextBox x:Name="LlamaContextSizeTextBox"
                                     Grid.Row="3" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintContextLength}"
                                     Text="262144"
                                     Margin="0,0,8,8"/>

                            <TextBox x:Name="LlamaGpuLayersTextBox"
                                     Grid.Row="3" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintGpuLayers}"
                                     Text="-1"
                                     Margin="8,0,0,8"/>

                            <PasswordBox x:Name="LlamaApiKeyPasswordBox"
                                         Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintLlamaApiKey}"
                                         Margin="0,0,0,8"/>

                            <TextBox x:Name="LlamaParallelSlotsTextBox"
                                     Grid.Row="5" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintParallelSlots}"
                                     Text="1"
                                     Margin="0,0,8,8"/>

                            <CheckBox x:Name="LlamaEnableFlashAttentionCheckBox"
                                      Grid.Row="5" Grid.Column="1"
                                      Content="{DynamicResource Loc.AICfg.EnableFlashAttention}"
                                      IsChecked="True"
                                      Margin="8,0,0,8"/>

                            <ComboBox x:Name="LlamaCacheTypeKComboBox"
                                      Grid.Row="6" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintCacheTypeK}"
                                      Margin="0,0,8,8">
                                <ComboBoxItem Content="q8_0" IsSelected="True"/>
                                <ComboBoxItem Content="q4_0"/>
                                <ComboBoxItem Content="f16"/>
                                <ComboBoxItem Content="f32"/>
                            </ComboBox>

                            <ComboBox x:Name="LlamaCacheTypeVComboBox"
                                      Grid.Row="6" Grid.Column="1"
                                      materialDesign:HintAssist.Hint="{DynamicResource Loc.AICfg.HintCacheTypeV}"
                                      Margin="8,0,0,8">
                                <ComboBoxItem Content="q8_0" IsSelected="True"/>
                                <ComboBoxItem Content="q4_0"/>
