                            <CheckBox x:Name="MCPAutoReconnectCheckBox"
                                      Grid.Row="2" Grid.Column="0"
                                      Content="自动重连"
                                      IsChecked="True"
                                      Margin="0,0,8,8"/>
                            
                            <CheckBox x:Name="MCPCompressionCheckBox"
                                      Grid.Row="2" Grid.Column="1"
                                      Content="启用压缩"
