<Window x:Class="NovelManagement.WPF.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改启动密码"
        Width="440" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource RegionBrush}">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="修改启动密码" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Grid.Row="1" Text="新密码将于下次启动应用时生效" FontSize="12" Margin="0,6,0,14"
                   HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="当前密码：" VerticalAlignment="Center" FontSize="13"/>
            <PasswordBox x:Name="CurrentPasswordBox" Grid.Column="1" Height="32" FontSize="14"
                         VerticalContentAlignment="Center" PasswordChar="●"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="新密码：" VerticalAlignment="Center" FontSize="13"/>
            <PasswordBox x:Name="NewPasswordBox" Grid.Column="1" Height="32" FontSize="14"
                         VerticalContentAlignment="Center" PasswordChar="●"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="确认新密码：" VerticalAlignment="Center" FontSize="13"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1" Height="32" FontSize="14"
                         VerticalContentAlignment="Center" PasswordChar="●"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Text="" FontSize="12" Margin="0,10,0,0"
                   Foreground="#E53935" HorizontalAlignment="Center" Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ConfirmButton" Grid.Column="0" Content="确 定" Height="34" FontSize="14"
                    Click="Confirm_Click"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="取 消" Height="34" FontSize="14"
                    IsCancel="True" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
