<UserControl x:Class="NovelManagement.WPF.Views.WorldSettingManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="15">
            <!-- 标题与按钮同场换行：英文按钮较宽，窄窗口时按钮整体换行，避免遮盖标题 -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <materialDesign:PackIcon Kind="Earth"
                                           Width="24" Height="24"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource Loc.World.Title}"
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5,0"
                            Click="AddWorldSetting_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Loc.WS.NewSetting}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5,0"
                            Background="{DynamicResource SecondaryHueMidBrush}"
                            Click="AIAnalysis_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Brain" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Loc.WS.AIAnalysis}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5,0"
                            Click="RefreshWorldSettings_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Loc.Dlg.Refresh}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5,0"
                            Click="ImportWorldSettings_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Loc.WS.ImportSettings}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="5,0"
                            Click="ExportWorldSettings_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Loc.WS.ExportSettings}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedAccentButton}"
                            Margin="5,0"
                            Click="AIAssistant_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource Loc.WS.AIAssistant}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </WrapPanel>
            </WrapPanel>
        </materialDesign:Card>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设定列表 -->
            <materialDesign:Card Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <TextBox Grid.Row="0"
                             x:Name="SearchTextBox"
                             materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.SearchHint}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="10"
                             TextChanged="SearchTextBox_TextChanged">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- 筛选器 -->
                    <StackPanel Grid.Row="1" Margin="10,0,10,10">
                        <ComboBox x:Name="TypeFilterComboBox"
                                  materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.FilterByType}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  SelectionChanged="TypeFilter_SelectionChanged"/>

                        <ComboBox x:Name="CategoryFilterComboBox"
                                  materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.FilterByCategory}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,10,0,0"
                                  SelectionChanged="CategoryFilter_SelectionChanged"/>
                    </StackPanel>

                    <!-- 设定列表 -->
                    <TreeView Grid.Row="2"
                              x:Name="WorldSettingsTreeView"
                              Margin="10"
                              SelectedItemChanged="WorldSettingsTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocument"
                                                           Width="16" Height="16"
                                                           Margin="0,0,5,0"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Type, StringFormat=' ({0})'}"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- 右侧：设定详情 -->
            <materialDesign:Card Grid.Column="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" Margin="20">
                        <!-- 设定详情将在代码中动态生成 -->
                        <TextBlock Text="{DynamicResource Loc.WS.SelectHint}"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
