<Window x:Class="NovelManagement.WPF.Views.EditProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{DynamicResource Loc.PM.EditProject}" Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:ColorZone Grid.Row="0"
                                  Mode="PrimaryMid"
                                  Background="{DynamicResource AppTitleBarBackgroundBrush}"
                                  Foreground="{DynamicResource AppTitleBarForegroundBrush}"
                                  Padding="16">
            <DockPanel>
                <materialDesign:PackIcon Kind="Edit"
                                       DockPanel.Dock="Left"
                                       Width="24" Height="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                <TextBlock Text="{DynamicResource Loc.PM.EditProject}"
                         FontSize="20"
                         FontWeight="Medium"
                         VerticalAlignment="Center"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- 项目基本信息 -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.NPD.BasicInfo}"
                                 FontSize="18"
                                 FontWeight="Medium"
                                 Margin="0,0,0,16"/>

                        <!-- 项目名称 -->
                        <TextBox x:Name="ProjectNameTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.NPD.NameHint}"
                               materialDesign:HintAssist.IsFloating="True"
                               Margin="0,0,0,16"/>

                        <!-- 项目描述 -->
                        <TextBox x:Name="ProjectDescriptionTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.NPD.DescriptionHint}"
                               materialDesign:HintAssist.IsFloating="True"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Height="80"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,16"/>

                        <!-- 项目类型 -->
                        <ComboBox x:Name="ProjectTypeComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.NPD.TypeHint}"
                                materialDesign:HintAssist.IsFloating="True"
                                Margin="0,0,0,16">
                            <ComboBoxItem Tag="修仙书籍" Content="{DynamicResource Loc.OG.TypeXianxia}"/>
                            <ComboBoxItem Tag="都市书籍" Content="{DynamicResource Loc.OG.TypeUrban}"/>
                            <ComboBoxItem Tag="科幻书籍" Content="{DynamicResource Loc.OG.TypeScifi}"/>
                            <ComboBoxItem Tag="奇幻书籍" Content="{DynamicResource Loc.NPD.TypeFantasy}"/>
                            <ComboBoxItem Tag="历史书籍" Content="{DynamicResource Loc.OG.TypeHistory}"/>
                            <ComboBoxItem Tag="军事书籍" Content="{DynamicResource Loc.NPD.TypeMilitary}"/>
                            <ComboBoxItem Tag="悬疑书籍" Content="{DynamicResource Loc.OG.TypeMystery}"/>
                            <ComboBoxItem Tag="言情书籍" Content="{DynamicResource Loc.OG.TypeRomance}"/>
                            <ComboBoxItem Tag="其他" Content="{DynamicResource Loc.PG.GenreOther}"/>
                        </ComboBox>

                        <!-- 项目状态 -->
                        <ComboBox x:Name="ProjectStatusComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.EPD.StatusHint}"
                                materialDesign:HintAssist.IsFloating="True"
                                Margin="0,0,0,0">
                            <ComboBoxItem Tag="进行中" Content="{DynamicResource Loc.PLM.StatusInProgress}"/>
                            <ComboBoxItem Tag="暂停" Content="{DynamicResource Loc.PLM.StatusPaused}"/>
                            <ComboBoxItem Tag="已完成" Content="{DynamicResource Loc.PLM.StatusCompleted}"/>
                            <ComboBoxItem Tag="已取消" Content="{DynamicResource Loc.TL.Data.已取消}"/>
                        </ComboBox>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2"
              Background="{DynamicResource MaterialDesignDivider}"
              Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Loc.Dlg.Cancel}"
                      Style="{StaticResource MaterialDesignFlatButton}"
                      Margin="0,0,8,0"
                      Click="Cancel_Click"/>
                <Button Content="{DynamicResource Loc.EPD.SaveChanges}"
                      Style="{StaticResource MaterialDesignRaisedButton}"
                      Click="SaveProject_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
