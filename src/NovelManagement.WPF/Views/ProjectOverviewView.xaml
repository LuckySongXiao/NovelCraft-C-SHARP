<UserControl x:Class="NovelManagement.WPF.Views.ProjectOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 项目标题 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="ProjectTitleTextBlock"
                         Text="{DynamicResource Loc.PM.ProjectName}"
                         FontSize="32"
                         FontWeight="Bold"
                         Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Loc.Nav.ProjectOverview}"
                         FontSize="18"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </StackPanel>

            <!-- 项目基本信息和进度统计 -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 项目基本信息 -->
                <materialDesign:Card Grid.Column="0" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PO.ProjectInfo}"
                                 FontSize="20"
                                 FontWeight="Medium"
                                 Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Loc.PO.TypeLabel}" FontWeight="Medium" Margin="0,0,16,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProjectTypeTextBlock" Text="{DynamicResource Loc.PO.NotSet}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Loc.PO.StatusLabel}" FontWeight="Medium" Margin="0,0,16,8"/>
                            <materialDesign:Chip Grid.Row="1" Grid.Column="1" x:Name="ProjectStatusChip" Content="{DynamicResource Loc.PO.NotSet}"
                                               Background="{DynamicResource PrimaryHueMidBrush}"
                                               Foreground="White"
                                               HorizontalAlignment="Left"
                                               Margin="0,0,0,8"
                                               Click="ProjectStatus_Click"
                                               Cursor="Hand"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Loc.PO.CreatedAtLabel}" FontWeight="Medium" Margin="0,0,16,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProjectCreatedTextBlock" Text="{DynamicResource Loc.PO.NotSet}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Loc.PO.LastUpdatedLabel}" FontWeight="Medium" Margin="0,0,16,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ProjectUpdatedTextBlock" Text="{DynamicResource Loc.PO.NotSet}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Loc.PO.AuthorLabel}" FontWeight="Medium" Margin="0,0,16,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ProjectAuthorTextBlock" Text="{DynamicResource Loc.PO.NotSet}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Loc.PO.TargetWordsLabel}" FontWeight="Medium" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProjectTargetWordsTextBlock" Text="{DynamicResource Loc.PO.NotSet}" Margin="0,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 进度统计 -->
                <materialDesign:Card Grid.Column="2" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PO.ProgressStats}"
                                 FontSize="20"
                                 FontWeight="Medium"
                                 Margin="0,0,0,16"/>

                        <!-- 字数进度 -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Loc.PO.TotalWords}" FontWeight="Medium"/>
                                <TextBlock x:Name="WordCountProgressTextBlock" Text="0 / 0" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="WordCountProgressBar" Value="0" Maximum="100" Height="8"/>
                            <TextBlock x:Name="WordCountPercentTextBlock" Text="{DynamicResource Loc.PO.PercentComplete}"
                                     FontSize="12"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Right"
                                     Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 章节进度 -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Loc.PO.ChapterCount}" FontWeight="Medium"/>
                                <TextBlock x:Name="ChapterCountProgressTextBlock" Text="0 / 0" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="ChapterCountProgressBar" Value="0" Maximum="100" Height="8"/>
                            <TextBlock x:Name="ChapterCountPercentTextBlock" Text="{DynamicResource Loc.PO.PercentComplete}"
                                     FontSize="12"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Right"
                                     Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 角色数量 -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.PO.CharacterCount}" FontWeight="Medium"/>
                            <TextBlock x:Name="CharacterCountTextBlock" Text="{DynamicResource Loc.PO.CountZero}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 设定完成度 -->
                        <Grid Margin="0,0,0,0">
                            <TextBlock Text="{DynamicResource Loc.PO.SettingCompletion}" FontWeight="Medium"/>
                            <TextBlock x:Name="SettingCompletionTextBlock" Text="0%" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- 运行流程与闭环 -->
            <materialDesign:Card Grid.Row="2" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.PO.ProcessFlowTitle}"
                             FontSize="20"
                             FontWeight="Medium"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Loc.PO.ProcessFlowIntro}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             Margin="0,0,0,16"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="180">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PO.Stage1}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ProjectBaseStageTextBlock"
                                             Margin="0,8,0,12"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             Text="{DynamicResource Loc.PO.Checking}"/>
                                    <Button Content="{DynamicResource Loc.PO.ProjectSettings}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Left"
                                            Click="ProjectSettings_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="12,0"/>

                            <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="180">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PO.Stage2}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WorldStageTextBlock"
                                             Margin="0,8,0,12"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             Text="{DynamicResource Loc.PO.Checking}"/>
                                    <Button Content="{DynamicResource Loc.Nav.WorldSettingManagement}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Left"
                                            Click="WorldSettings_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="12,0"/>

                            <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="180">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PO.Stage3}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OutlineStageTextBlock"
                                             Margin="0,8,0,12"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             Text="{DynamicResource Loc.PO.Checking}"/>
                                    <Button Content="{DynamicResource Loc.Nav.PlotManagement}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Left"
                                            Click="PlotOutline_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="12,0"/>

                            <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="180">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PO.Stage4}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SupportStageTextBlock"
                                             Margin="0,8,0,12"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             Text="{DynamicResource Loc.PO.Checking}"/>
                                    <Button Content="{DynamicResource Loc.PO.CharactersAndFactions}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Left"
                                            Click="ManageSupportSettings_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="12,0"/>

                            <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="180">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.PO.Stage5}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WritingStageTextBlock"
                                             Margin="0,8,0,12"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             Text="{DynamicResource Loc.PO.Checking}"/>
                                    <Button Content="{DynamicResource Loc.PO.VolumeChapterManagement}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Left"
                                            Click="WriteChapter_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="ParallelStageHintTextBlock"
                             Margin="0,16,0,6"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             Text="{DynamicResource Loc.PO.ParallelHint}"/>
                    <TextBlock x:Name="ClosedLoopHintTextBlock"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             Text="{DynamicResource Loc.PO.ClosedLoopHint}"/>
                    <TextBlock x:Name="AutoUpdateFlowTextBlock"
                             Margin="0,10,0,0"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             Text="{DynamicResource Loc.PO.AutoUpdateHint}"/>
                    <TextBlock x:Name="WorkflowReviewHintTextBlock"
                             Margin="0,6,0,0"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             Text="{DynamicResource Loc.PO.ReviewHint}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="TimelineReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Timeline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.TimelineReview}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="RelationshipReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="GraphOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.RelationshipReview}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="ConsistencyReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckDecagram" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.ConsistencyCheck}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="QualityReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Side.Btn.QualityCheck}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="NextActionTextBlock"
                             Margin="0,12,0,0"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Text="{DynamicResource Loc.PO.NextActionChecking}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 快速操作 -->
            <materialDesign:Card Grid.Row="3" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.PO.QuickActionsByFlow}"
                             FontSize="20"
                             FontWeight="Medium"
                             Margin="0,0,0,16"/>

                    <WrapPanel>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,12,8"
                                Click="OpenProcessWorkbench_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SourceBranch" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.ProcessWorkbench}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="ProjectSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.ProjectSettings}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="WorldSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Earth" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Nav.WorldSettingManagement}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="PlotOutline_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileTree" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.PlotOutline}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="ManageCharacters_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.ManageCharacters}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="ManageFactions_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldAccount" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.ManageFactions}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="TimelineReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Timeline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Nav.Timeline}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="RelationshipReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="GraphOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Nav.RelationshipNetwork}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="ConsistencyReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckDecagram" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.ConsistencyCheck}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="QualityReview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Side.Btn.QualityCheck}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="WriteChapter_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.WriteNewChapter}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="AIAssistant_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Side.Group.AIAssistant}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="ImportExport_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.Nav.ImportExport}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="Statistics_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartLine" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.Statistics}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,12,8"
                                Click="Backup_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Backup" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.PO.BackupProject}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 详细内容区域 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 角色概览 -->
                <materialDesign:Card Grid.Column="0" Padding="24">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Loc.PO.MainCharacters}"
                                     FontSize="20"
                                     FontWeight="Medium"
                                     DockPanel.Dock="Left"/>
                            <Button Content="{DynamicResource Loc.PO.ViewAll}"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  DockPanel.Dock="Right"
                                  Click="ViewAllCharacters_Click"/>
                        </DockPanel>

                        <!-- 角色列表区域 -->
                        <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                              CornerRadius="4"
                              Padding="16"
                              MinHeight="200">
                            <TextBlock x:Name="CharacterListTextBlock"
                                     Text="{DynamicResource Loc.PO.NoCharacters}"
                                     FontSize="14"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     TextWrapping="Wrap"
                                     LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 剧情大纲 -->
                <materialDesign:Card Grid.Column="2" Padding="24">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Loc.PO.PlotOutline}"
                                     FontSize="20"
                                     FontWeight="Medium"
                                     DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="{DynamicResource Loc.PO.GenerateOutlineAI}"
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Background="{DynamicResource PrimaryHueMidBrush}"
                                      Foreground="White"
                                      Margin="0,0,8,0"
                                      Click="GenerateOutline_Click"/>
                                <Button Content="{DynamicResource Loc.PO.EditOutline}"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      Click="EditOutline_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 大纲内容区域 -->
                        <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                              CornerRadius="4"
                              Padding="16"
                              MinHeight="200">
                            <TextBlock x:Name="OutlineContentTextBlock"
                                     Text="{DynamicResource Loc.PO.NoOutline}"
                                     FontSize="14"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     TextWrapping="Wrap"
                                     LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
