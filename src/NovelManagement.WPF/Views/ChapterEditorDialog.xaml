<Window x:Class="NovelManagement.WPF.Views.ChapterEditorDialog" Icon="pack://application:,,,/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{DynamicResource Loc.CE.Title}" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,8">
            <DockPanel>
                <!-- 左侧：章节信息 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocument" 
                                           Width="24" Height="24" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock x:Name="ChapterTitleLabel"
                             Text="{DynamicResource Loc.CE.SampleTitle}" 
                             FontSize="18" 
                             FontWeight="Medium"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
                    <TextBlock x:Name="WordCountLabel"
                             Text="{DynamicResource Loc.CE.WordsPlaceholder}" 
                             FontSize="14" 
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 右侧：操作按钮 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- AI功能按钮组 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Button x:Name="AIWriteButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,4,0"
                                Click="AIWrite_Click"
                                ToolTip="{DynamicResource Loc.CE.AIWriteTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RobotExcited" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CE.AIWrite}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AIContinueButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,4,0"
                                Click="AIContinue_Click"
                                ToolTip="{DynamicResource Loc.CE.AIContinueTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RobotLove" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CE.AIContinue}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AIPolishButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,4,0"
                                Click="AIPolish_Click"
                                ToolTip="{DynamicResource Loc.CE.AIPolishTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CE.AIPolish}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ConsistencyCheckButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"
                                Click="ConsistencyCheck_Click"
                                ToolTip="{DynamicResource Loc.CE.AIConsistencyTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CE.ConsistencyCheck}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 基础功能按钮组 -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveDraftButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"
                                Click="SaveDraft_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CE.SaveDraft}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"
                                Click="Preview_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Eye" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.Dlg.Preview}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="SaveAndClose_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc.CE.SaveAndClose}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- 主编辑区域 -->
        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：文本编辑器 -->
            <materialDesign:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 编辑器标题栏 -->
                    <Border Grid.Row="0" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                     Text="{DynamicResource Loc.CE.ContentTitle}" 
                                     FontWeight="Medium"/>
                            <StackPanel DockPanel.Dock="Right" 
                                      Orientation="Horizontal">
                                <TextBlock x:Name="CurrentWordCount"
                                         Text="{DynamicResource Loc.CE.CurrentWords}" 
                                         FontSize="12"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text=" / " 
                                         FontSize="12"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock x:Name="TargetWordCount"
                                         Text="{DynamicResource Loc.CE.TargetWords}" 
                                         FontSize="12"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 文本编辑器 -->
                    <TextBox x:Name="ContentTextBox"
                           Grid.Row="1"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Auto"
                           FontFamily="Consolas, Microsoft YaHei"
                           FontSize="14"
                           Padding="16"
                           BorderThickness="0"
                           TextChanged="ContentTextBox_TextChanged"/>

                    <!-- 状态栏 -->
                    <Border Grid.Row="2" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                     x:Name="StatusLabel"
                                     Text="{DynamicResource Loc.CE.StatusEditing}" 
                                     FontSize="12"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock DockPanel.Dock="Right"
                                     x:Name="LastSavedLabel"
                                     Text="{DynamicResource Loc.CE.LastSaved}" 
                                     FontSize="12"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- 右侧：章节信息面板 -->
            <materialDesign:Card Grid.Column="2" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 章节信息 -->
                        <TextBlock Text="{DynamicResource Loc.CE.InfoTitle}" 
                                 FontSize="16" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,16"/>

                        <!-- 章节标题 -->
                        <TextBox x:Name="TitleTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CE.TitleHint}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Margin="0,0,0,12"
                               MaxLength="100"/>

                        <!-- 章节摘要 -->
                        <TextBox x:Name="SummaryTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.CE.SummaryHint}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               MinHeight="60"
                               MaxHeight="100"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,12"
                               MaxLength="500"/>

                        <!-- 章节状态 -->
                        <ComboBox x:Name="StatusComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.CE.StatusHint}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Margin="0,0,0,12">
                            <ComboBoxItem Tag="计划中" Content="{DynamicResource Loc.CE.Data.计划中}"/>
                            <ComboBoxItem Tag="大纲中" Content="{DynamicResource Loc.CE.Data.大纲中}"/>
                            <ComboBoxItem Tag="写作中" Content="{DynamicResource Loc.CE.Data.写作中}" IsSelected="True"/>
                            <ComboBoxItem Tag="初稿完成" Content="{DynamicResource Loc.CE.Data.初稿完成}"/>
                            <ComboBoxItem Tag="修改中" Content="{DynamicResource Loc.CE.Data.修改中}"/>
                            <ComboBoxItem Tag="已完成" Content="{DynamicResource Loc.CE.Data.已完成}"/>
                        </ComboBox>

                        <!-- 重要性等级 -->
                        <ComboBox x:Name="ImportanceComboBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.CE.ImportanceHint}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Margin="0,0,0,12">
                            <ComboBoxItem Content="{DynamicResource Loc.CE.Data.Imp1}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.CE.Data.Imp2}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Loc.CE.Data.Imp3}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.CE.Data.Imp4}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.CE.Data.Imp5}"/>
                        </ComboBox>

                        <!-- 相关角色 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBox x:Name="CharactersTextBox"
                                   materialDesign:HintAssist.Hint="{DynamicResource Loc.CE.RelatedChars}"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   MaxLength="300"
                                   TextChanged="CharactersTextBox_TextChanged"
                                   GotKeyboardFocus="CharactersTextBox_GotKeyboardFocus"
                                   PreviewKeyDown="CharactersTextBox_PreviewKeyDown"/>
                            <Border x:Name="CharacterSuggestionsBorder"
                                  Margin="0,4,0,0"
                                  Padding="4"
                                  Background="{DynamicResource MaterialDesignPaper}"
                                  BorderBrush="{DynamicResource MaterialDesignDivider}"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CE.CharSuggestions}"
                                             FontSize="12"
                                             Margin="4,0,4,4"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <ListBox x:Name="CharacterSuggestionsListBox"
                                             MaxHeight="120"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             SelectionChanged="CharacterSuggestionsListBox_SelectionChanged"
                                             MouseDoubleClick="CharacterSuggestionsListBox_MouseDoubleClick"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 标签 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBox x:Name="TagsTextBox"
                                   materialDesign:HintAssist.Hint="{DynamicResource Loc.CE.TagsHint}"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   MaxLength="200"
                                   TextChanged="TagsTextBox_TextChanged"
                                   GotKeyboardFocus="TagsTextBox_GotKeyboardFocus"
                                   PreviewKeyDown="TagsTextBox_PreviewKeyDown"/>
                            <Border x:Name="TagSuggestionsBorder"
                                  Margin="0,4,0,0"
                                  Padding="4"
                                  Background="{DynamicResource MaterialDesignPaper}"
                                  BorderBrush="{DynamicResource MaterialDesignDivider}"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CE.TagSuggestions}"
                                             FontSize="12"
                                             Margin="4,0,4,4"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <ListBox x:Name="TagSuggestionsListBox"
                                             MaxHeight="120"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             SelectionChanged="TagSuggestionsListBox_SelectionChanged"
                                             MouseDoubleClick="TagSuggestionsListBox_MouseDoubleClick"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button x:Name="ExtractMetadataButton"
                                Content="{DynamicResource Loc.CE.MatchBtn}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,8"
                                Click="ExtractMetadataButton_Click"/>
                        <TextBlock Text="{DynamicResource Loc.CE.MatchDesc}"
                                 FontSize="12"
                                 Margin="0,0,0,12"
                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                 TextWrapping="Wrap"/>

                        <!-- 备注 -->
                        <TextBox x:Name="NotesTextBox"
                               materialDesign:HintAssist.Hint="{DynamicResource Loc.Dlg.Remarks}"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               MinHeight="60"
                               MaxHeight="100"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0,0,0,16"
                               MaxLength="500"/>

                        <!-- 写作统计 -->
                        <Separator Margin="0,0,0,16"/>
                        
                        <TextBlock Text="{DynamicResource Loc.CE.WritingStats}" 
                                 FontSize="14" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Loc.CE.WordsLabel}" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatsWordCount" Text="0" FontSize="12" HorizontalAlignment="Right"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Loc.CE.ParagraphsLabel}" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatsParagraphs" Text="0" FontSize="12" HorizontalAlignment="Right"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Loc.CE.LinesLabel}" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatsLines" Text="0" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" 
              Background="{DynamicResource MaterialDesignDivider}" 
              Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                         Text="{DynamicResource Loc.CE.HintText}" 
                         FontSize="12"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock DockPanel.Dock="Right"
                         x:Name="AutoSaveLabel"
                         Text="{DynamicResource Loc.CE.AutosaveOn}" 
                         FontSize="12"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
