<UserControl x:Class="NovelManagement.WPF.Views.BusinessSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryHueMidBrush}" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Store" 
                                           Foreground="White" 
                                           Width="32" 
                                           Height="32" 
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Loc.WS.Bus.Title}" 
                             Foreground="White" 
                             FontSize="24" 
                             FontWeight="Medium" 
                             VerticalAlignment="Center" 
                             Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="AddBusiness_Click"
                            ToolTip="{DynamicResource Loc.WS.Bus.NewTooltip}">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Foreground="White" 
                            Margin="8,0"
                            Click="ImportBusiness_Click"
                            ToolTip="{DynamicResource Loc.WS.Bus.ImportTooltip}">
                        <materialDesign:PackIcon Kind="Import" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="ExportBusiness_Click"
                            ToolTip="{DynamicResource Loc.WS.Bus.ExportTooltip}">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White"
                            Margin="8,0"
                            Click="AIAssistant_Click"
                            ToolTip="{DynamicResource Loc.WS.Common.AIAssistant}">
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：商业体系列表 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Padding="16,16,16,8">
                        <TextBox x:Name="SearchTextBox"
                                materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.SearchHint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="SearchTextBox_TextChanged"/>
                    </Border>

                    <!-- 筛选器 -->
                    <Border Grid.Row="1" Padding="16,0,16,8">
                        <StackPanel>
                            <ComboBox x:Name="CategoryFilterComboBox"
                                     materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.CategoryHint}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="CategoryFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Loc.WS.Common.AllCategories}"/>
                                <ComboBoxItem Tag="贸易商行" Content="{DynamicResource Loc.WS.Bus.Data.贸易商行}"/>
                                <ComboBoxItem Tag="拍卖行" Content="{DynamicResource Loc.WS.Bus.Data.拍卖行}"/>
                                <ComboBoxItem Tag="炼器坊" Content="{DynamicResource Loc.WS.Bus.Data.炼器坊}"/>
                                <ComboBoxItem Tag="丹药铺" Content="{DynamicResource Loc.WS.Bus.Data.丹药铺}"/>
                                <ComboBoxItem Tag="客栈" Content="{DynamicResource Loc.WS.Bus.Data.客栈}"/>
                                <ComboBoxItem Tag="传送阵" Content="{DynamicResource Loc.WS.Bus.Data.传送阵}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 商业体系列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BusinessListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectBusinessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                       Kind="Store" 
                                                                       Width="20" 
                                                                       Height="20" 
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>

                                                <Border Grid.Column="2" 
                                                      Background="{DynamicResource PrimaryHueLightBrush}"
                                                      CornerRadius="8"
                                                      Padding="6,2">
                                                    <TextBlock Text="{Binding Category}" 
                                                             Foreground="White" 
                                                             FontSize="10"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" 
                                                     Text="{Binding Description}" 
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     FontSize="12"
                                                     Margin="28,4,0,0"
                                                     TextWrapping="Wrap"/>

                                            <StackPanel Grid.Row="2" 
                                                      Orientation="Horizontal" 
                                                      Margin="28,4,0,0">
                                                <TextBlock Text="{DynamicResource Loc.WS.Bus.ProductCountLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="{Binding ProductCount}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                                <TextBlock Text="{DynamicResource Loc.WS.Bus.ServiceCountLabel}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding ServiceCount}" 
                                                         FontSize="11" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 统计信息 -->
                    <Border Grid.Row="3" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.WS.Bus.Stats}" 
                                     FontWeight="Medium" 
                                     FontSize="12" 
                                     Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Common.TotalLabel}"/>
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.贸易商行}"/>
                                        <Run Text="{Binding TradeCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.拍卖行}"/>
                                        <Run Text="{Binding AuctionCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{DynamicResource Loc.WS.Stat.炼器坊}"/>
                                        <Run Text="{Binding CraftCount, Mode=OneWay}" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 右侧：商业详情编辑区域 -->
            <materialDesign:Card Grid.Column="1" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="24">
                        <!-- 默认提示 -->
                        <StackPanel x:Name="EmptyStatePanel"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Visible">
                            <materialDesign:PackIcon Kind="StoreOutline"
                                                   Width="64"
                                                   Height="64"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Bus.NoSelection}"
                                     FontSize="16"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center"
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource Loc.WS.Bus.NoSelectionHint}"
                                     FontSize="14"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 商业详情编辑面板 -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <!-- 基本信息 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Common.BasicInfo}"
                                     FontSize="18"
                                     FontWeight="Medium"
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="BusinessNameTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.NameHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <ComboBox Grid.Column="2"
                                         x:Name="BusinessCategoryComboBox"
                                         materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.CategoryHint}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,16">
                                    <ComboBoxItem Tag="贸易商行" Content="{DynamicResource Loc.WS.Bus.Data.贸易商行}"/>
                                    <ComboBoxItem Tag="拍卖行" Content="{DynamicResource Loc.WS.Bus.Data.拍卖行}"/>
                                    <ComboBoxItem Tag="炼器坊" Content="{DynamicResource Loc.WS.Bus.Data.炼器坊}"/>
                                    <ComboBoxItem Tag="丹药铺" Content="{DynamicResource Loc.WS.Bus.Data.丹药铺}"/>
                                    <ComboBoxItem Tag="客栈" Content="{DynamicResource Loc.WS.Bus.Data.客栈}"/>
                                    <ComboBoxItem Tag="传送阵" Content="{DynamicResource Loc.WS.Bus.Data.传送阵}"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="BusinessLocationTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.LocationHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Column="2"
                                        x:Name="BusinessOwnerTextBox"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.OperatorHint}"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,0,0,16"/>
                            </Grid>

                            <TextBox x:Name="BusinessDescriptionTextBox"
                                    materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.DescHint}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinLines="3"
                                    MaxLines="5"
                                    Margin="0,0,0,24"/>

                            <!-- 商品管理 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Bus.ProductsTitle}"
                                     FontSize="18"
                                     FontWeight="Medium"
                                     Margin="0,0,0,16"/>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Padding="16"
                                  Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                 Text="{DynamicResource Loc.WS.Bus.ProductList}"
                                                 FontWeight="Medium"/>

                                        <Button Grid.Column="1"
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              Click="AddProduct_Click"
                                              ToolTip="{DynamicResource Loc.WS.Bus.AddProductTooltip}">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="ProductListControl" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                      BorderThickness="0,0,0,1"
                                                      Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.ProductNameHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <TextBox Grid.Column="1"
                                                               Text="{Binding Price}"
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.PriceHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <TextBox Grid.Column="2"
                                                               Text="{Binding Description}"
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.ProductDescHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <Button Grid.Column="3"
                                                              Style="{StaticResource MaterialDesignIconButton}"
                                                              Click="RemoveProduct_Click"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="{DynamicResource Loc.WS.Bus.DeleteProductTooltip}">
                                                            <materialDesign:PackIcon Kind="Delete"
                                                                                   Foreground="{DynamicResource ValidationErrorBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 服务管理 -->
                            <TextBlock Text="{DynamicResource Loc.WS.Bus.ServicesTitle}"
                                     FontSize="18"
                                     FontWeight="Medium"
                                     Margin="0,0,0,16"/>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Padding="16"
                                  Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                 Text="{DynamicResource Loc.WS.Bus.ServiceList}"
                                                 FontWeight="Medium"/>

                                        <Button Grid.Column="1"
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              Click="AddService_Click"
                                              ToolTip="{DynamicResource Loc.WS.Bus.AddServiceTooltip}">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="ServiceListControl" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                      BorderThickness="0,0,0,1"
                                                      Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.ServiceNameHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <TextBox Grid.Column="1"
                                                               Text="{Binding Fee}"
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.ServiceFeeHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <TextBox Grid.Column="2"
                                                               Text="{Binding Description}"
                                                               materialDesign:HintAssist.Hint="{DynamicResource Loc.WS.Bus.ServiceDescHint}"
                                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                               Margin="0,0,8,0"/>

                                                        <Button Grid.Column="3"
                                                              Style="{StaticResource MaterialDesignIconButton}"
                                                              Click="RemoveService_Click"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="{DynamicResource Loc.WS.Bus.DeleteServiceTooltip}">
                                                            <materialDesign:PackIcon Kind="Delete"
                                                                                   Foreground="{DynamicResource ValidationErrorBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal"
                                      HorizontalAlignment="Right"
                                      Margin="0,16,0,0">
                                <Button Content="{DynamicResource Loc.Dlg.Save}"
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Click="SaveBusiness_Click"
                                      Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Loc.Dlg.Cancel}"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Click="CancelEdit_Click"
                                      Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
