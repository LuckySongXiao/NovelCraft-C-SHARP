<UserControl x:Class="NovelManagement.WPF.Views.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Loc.IE.PageTitle}"
                     FontSize="32"
                     FontWeight="Bold"
                     Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Loc.IE.PageSubtitle}"
                     FontSize="16"
                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- 主要内容区域 -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">
            
            <!-- 导出标签页 -->
            <TabItem Header="{DynamicResource Loc.IE.ExportTab}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.IE.ExportTab}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧 - 导出配置 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 导出配置面板 -->
                        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.IE.ExportConfig}" 
                                         FontSize="18" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,16"/>

                                <!-- 导出格式选择 -->
                                <TextBlock Text="{DynamicResource Loc.IE.ExportFormat}" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <ComboBox x:Name="ExportFormatComboBox"
                                        Style="{StaticResource MaterialDesignComboBox}"
                                        Margin="0,0,0,16"
                                        SelectedIndex="0">
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtTxt}" Tag="TXT"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtExcel}" Tag="EXCEL"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtDocx}" Tag="DOCX"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtHtml}" Tag="HTML"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtMarkdown}" Tag="MARKDOWN"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtJson}" Tag="JSON"/>
                                </ComboBox>

                                <!-- 导出范围选择 -->
                                <TextBlock Text="{DynamicResource Loc.IE.ExportScope}" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <ComboBox x:Name="ExportScopeComboBox"
                                        Style="{StaticResource MaterialDesignComboBox}"
                                        Margin="0,0,0,16"
                                        SelectedIndex="0"
                                        SelectionChanged="ExportScope_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.ScopeEntireProject}" Tag="EntireProject"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.ScopeSelectedVolumes}" Tag="SelectedVolumes"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.ScopeSelectedChapters}" Tag="SelectedChapters"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.ScopeCustomRange}" Tag="CustomRange"/>
                                </ComboBox>

                                <!-- 选择项目列表 -->
                                <StackPanel x:Name="SelectionPanel" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Loc.IE.SelectItems}" 
                                             FontWeight="Medium" 
                                             Margin="0,0,0,8"/>
                                    <ListBox x:Name="SelectionListBox" 
                                           Height="120" 
                                           SelectionMode="Multiple"
                                           Margin="0,0,0,16">
                                        <ListBoxItem Content="{DynamicResource Loc.IE.SampleVolume1}"/>
                                        <ListBoxItem Content="{DynamicResource Loc.IE.SampleVolume2}"/>
                                        <ListBoxItem Content="{DynamicResource Loc.IE.SampleVolume3}"/>
                                    </ListBox>
                                </StackPanel>

                                <!-- 包含内容选项 -->
                                <TextBlock Text="{DynamicResource Loc.IE.IncludeContent}" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <StackPanel>
                                    <CheckBox x:Name="IncludeSettingsCheckBox" 
                                            Content="{DynamicResource Loc.IE.IncludeSettings}" 
                                            IsChecked="True" 
                                            Margin="0,4"/>
                                    <CheckBox x:Name="IncludeCharactersCheckBox" 
                                            Content="{DynamicResource Loc.IE.IncludeCharacters}" 
                                            IsChecked="True" 
                                            Margin="0,4"/>
                                    <CheckBox x:Name="IncludeFactionsCheckBox" 
                                            Content="{DynamicResource Loc.IE.IncludeFactions}" 
                                            IsChecked="True" 
                                            Margin="0,4"/>
                                    <CheckBox x:Name="IncludePlotsCheckBox" 
                                            Content="{DynamicResource Loc.IE.IncludePlots}" 
                                            IsChecked="True" 
                                            Margin="0,4"/>
                                </StackPanel>

                                <!-- 输出路径 -->
                                <TextBlock Text="{DynamicResource Loc.IE.OutputPath}" 
                                         FontWeight="Medium" 
                                         Margin="0,16,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputPathTextBox" 
                                           Grid.Column="0"
                                           Style="{StaticResource MaterialDesignTextBox}"
                                           materialDesign:HintAssist.Hint="{DynamicResource Loc.IE.OutputPathHint}"/>
                                    <Button Grid.Column="1" 
                                          Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="{DynamicResource Loc.IE.BrowseFolder}"
                                          Click="BrowseOutputPath_Click"
                                          Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="FolderOpen"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 导出按钮 -->
                        <Button Grid.Row="2" 
                              Content="{DynamicResource Loc.IE.StartExport}" 
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="40"
                              Click="StartExport_Click"/>
                    </Grid>

                    <!-- 分隔符 -->
                    <GridSplitter Grid.Column="1" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch" 
                                Background="{DynamicResource MaterialDesignDivider}"/>

                    <!-- 右侧 - 导出进度和历史 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 当前导出进度 -->
                        <materialDesign:Card Grid.Row="0" 
                                           Padding="16" 
                                           Margin="0,0,0,16"
                                           x:Name="ExportProgressCard"
                                           Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="Export" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc.IE.ExportProgress}" 
                                             FontSize="16" 
                                             FontWeight="Medium" 
                                             VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="{DynamicResource Loc.IE.CancelExport}"
                                          Margin="8,0,0,0"
                                          Click="CancelExport_Click">
                                        <materialDesign:PackIcon Kind="Cancel"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="ExportStatusText" 
                                         Text="{DynamicResource Loc.IE.Preparing}" 
                                         Margin="0,0,0,8"/>
                                
                                <ProgressBar x:Name="ExportProgressBar" 
                                           Value="0" 
                                           Maximum="100" 
                                           Height="8" 
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock x:Name="ExportProgressText" 
                                         Text="{DynamicResource Loc.IE.ItemsProcessed0}" 
                                         FontSize="12" 
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 导出历史记录 -->
                        <materialDesign:Card Grid.Row="1" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 历史记录标题 -->
                                <Border Grid.Row="0" 
                                      Background="{DynamicResource MaterialDesignToolBarBackground}" 
                                      Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="History" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Loc.IE.ExportHistory}" 
                                                 FontSize="16" 
                                                 FontWeight="Medium" 
                                                 VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                              ToolTip="{DynamicResource Loc.IE.RefreshHistory}"
                                              Margin="8,0,0,0"
                                              Click="RefreshExportHistory_Click">
                                            <materialDesign:PackIcon Kind="Refresh"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 历史记录列表 -->
                                <ListView Grid.Row="1" 
                                        x:Name="ExportHistoryListView"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,12" 
                                                  BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                  BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 状态图标 -->
                                                    <materialDesign:PackIcon Grid.Column="0" 
                                                                           Kind="{Binding StatusIcon}" 
                                                                           Width="24" Height="24" 
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding StatusColor}"/>

                                                    <!-- 导出信息 -->
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding FormatDisplay}" 
                                                                 FontWeight="Medium" 
                                                                 FontSize="14"/>
                                                        <TextBlock Text="{Binding FilePath}" 
                                                                 FontSize="12" 
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding StartTimeDisplay}" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding FileSizeDisplay}" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </StackPanel>

                                                    <!-- 操作按钮 -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                              ToolTip="{DynamicResource Loc.IE.OpenFile}"
                                                              Click="OpenExportFile_Click"
                                                              Tag="{Binding}">
                                                            <materialDesign:PackIcon Kind="FileOpen"/>
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                              ToolTip="{DynamicResource Loc.IE.OpenFolder}"
                                                              Click="OpenExportFolder_Click"
                                                              Tag="{Binding}">
                                                            <materialDesign:PackIcon Kind="FolderOpen"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 导入标签页 -->
            <TabItem Header="{DynamicResource Loc.IE.ImportTab}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Import" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.IE.ImportTab}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧 - 导入配置 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 导入配置面板 -->
                        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.IE.ImportConfig}" 
                                         FontSize="18" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,16"/>

                                <!-- 选择文件 -->
                                <TextBlock Text="{DynamicResource Loc.IE.SelectFile}" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ImportFilePathTextBox" 
                                           Grid.Column="0"
                                           Style="{StaticResource MaterialDesignTextBox}"
                                           materialDesign:HintAssist.Hint="{DynamicResource Loc.IE.ImportFileHint}"/>
                                    <Button Grid.Column="1" 
                                          Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="{DynamicResource Loc.IE.BrowseFile}"
                                          Click="BrowseImportFile_Click"
                                          Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="FileSearch"/>
                                    </Button>
                                </Grid>

                                <!-- 文件格式 -->
                                <TextBlock Text="{DynamicResource Loc.IE.FileFormat}" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <ComboBox x:Name="ImportFormatComboBox"
                                        Style="{StaticResource MaterialDesignComboBox}"
                                        Margin="0,0,0,16"
                                        SelectedIndex="0">
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtExcelFile}" Tag="EXCEL"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtDocxFile}" Tag="DOCX"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtCsvFile}" Tag="CSV"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtTxtFile}" Tag="TXT"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtJsonFile}" Tag="JSON"/>
                                    <ComboBoxItem Content="{DynamicResource Loc.IE.FmtXmlFile}" Tag="XML"/>
                                </ComboBox>

                                <!-- 导入选项 -->
                                <TextBlock Text="{DynamicResource Loc.IE.ImportOptions}" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <StackPanel>
                                    <CheckBox x:Name="OverwriteExistingCheckBox" 
                                            Content="{DynamicResource Loc.IE.OverwriteExisting}" 
                                            Margin="0,4"/>
                                    <CheckBox x:Name="CreateBackupCheckBox" 
                                            Content="{DynamicResource Loc.IE.CreateBackup}" 
                                            IsChecked="True" 
                                            Margin="0,4"/>
                                </StackPanel>

                                <!-- 预览按钮 -->
                                <Button Content="{DynamicResource Loc.IE.PreviewFile}" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Margin="0,16,0,0"
                                      Click="PreviewImportFile_Click"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 导入按钮 -->
                        <Button Grid.Row="2" 
                              Content="{DynamicResource Loc.IE.StartImport}" 
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="40"
                              Click="StartImport_Click"/>
                    </Grid>

                    <!-- 分隔符 -->
                    <GridSplitter Grid.Column="1" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch" 
                                Background="{DynamicResource MaterialDesignDivider}"/>

                    <!-- 右侧 - 导入进度和历史 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 当前导入进度 -->
                        <materialDesign:Card Grid.Row="0" 
                                           Padding="16" 
                                           Margin="0,0,0,16"
                                           x:Name="ImportProgressCard"
                                           Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="Import" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc.IE.ImportProgress}" 
                                             FontSize="16" 
                                             FontWeight="Medium" 
                                             VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="{DynamicResource Loc.IE.CancelImport}"
                                          Margin="8,0,0,0"
                                          Click="CancelImport_Click">
                                        <materialDesign:PackIcon Kind="Cancel"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="ImportStatusText" 
                                         Text="{DynamicResource Loc.IE.Preparing}" 
                                         Margin="0,0,0,8"/>
                                
                                <ProgressBar x:Name="ImportProgressBar" 
                                           Value="0" 
                                           Maximum="100" 
                                           Height="8" 
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock x:Name="ImportProgressText" 
                                         Text="{DynamicResource Loc.IE.ItemsProcessed0}" 
                                         FontSize="12" 
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 导入历史记录 -->
                        <materialDesign:Card Grid.Row="1" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 历史记录标题 -->
                                <Border Grid.Row="0" 
                                      Background="{DynamicResource MaterialDesignToolBarBackground}" 
                                      Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="History" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Loc.IE.ImportHistory}" 
                                                 FontSize="16" 
                                                 FontWeight="Medium" 
                                                 VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                              ToolTip="{DynamicResource Loc.IE.RefreshHistory}"
                                              Margin="8,0,0,0"
                                              Click="RefreshImportHistory_Click">
                                            <materialDesign:PackIcon Kind="Refresh"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 历史记录列表 -->
                                <ListView Grid.Row="1" 
                                        x:Name="ImportHistoryListView"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,12" 
                                                  BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                  BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 状态图标 -->
                                                    <materialDesign:PackIcon Grid.Column="0" 
                                                                           Kind="{Binding StatusIcon}" 
                                                                           Width="24" Height="24" 
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding StatusColor}"/>

                                                    <!-- 导入信息 -->
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding FormatDisplay}" 
                                                                 FontWeight="Medium" 
                                                                 FontSize="14"/>
                                                        <TextBlock Text="{Binding FilePath}" 
                                                                 FontSize="12" 
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding StartTimeDisplay}" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding FileSizeDisplay}" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </StackPanel>

                                                    <!-- 操作按钮 -->
                                                    <Button Grid.Column="2" 
                                                          Style="{StaticResource MaterialDesignIconButton}"
                                                          ToolTip="{DynamicResource Loc.IE.ViewDetails}"
                                                          Click="ViewImportDetails_Click"
                                                          Tag="{Binding}">
                                                        <materialDesign:PackIcon Kind="Information"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
