<UserControl x:Class="NovelManagement.WPF.Views.CharacterManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:localization="clr-namespace:NovelManagement.WPF.Localization"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <localization:StoredValueConverter x:Key="StoredValueConverter"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Loc.CM.Title}" 
                     FontSize="32" 
                     FontWeight="Bold" 
                     Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Loc.CM.Subtitle}" 
                     FontSize="16" 
                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- 操作工具栏 -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,12,0"
                            Click="NewCharacter_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.CM.New}"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="ImportCharacters_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Import" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.CM.Import}"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="ExportCharacters_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.CM.Export}"/>
                        </StackPanel>
                    </Button>

                    <!-- AI辅助功能分隔符 -->
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                             Margin="12,0"/>

                    <!-- AI辅助按钮组 -->
                    <Button Style="{StaticResource MaterialDesignRaisedAccentButton}"
                            Margin="0,0,8,0"
                            Click="AIGenerateCharacter_Click"
                            ToolTip="{DynamicResource Loc.CM.AIGenerateTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Brain" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.CM.AIGenerate}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            Click="AIOptimizeCharacter_Click"
                            ToolTip="{DynamicResource Loc.CM.AIOptimizeTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AutoFix" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.CM.AIOptimize}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Click="AIAnalyzeRelationships_Click"
                            ToolTip="{DynamicResource Loc.CM.RelationAnalysisTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="GraphOutline" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc.CM.RelationAnalysis}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 筛选和搜索 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="CharacterTypeFilter"
                            materialDesign:HintAssist.Hint="{DynamicResource Loc.CM.TypeHint}"
                            Width="120"
                            Margin="0,0,12,0"
                            SelectionChanged="CharacterTypeFilter_SelectionChanged">
                        <ComboBoxItem Tag="全部" Content="{DynamicResource Loc.CM.TypeAll}"/>
                        <ComboBoxItem Tag="主角" Content="{DynamicResource Loc.CM.TypeProtagonist}"/>
                        <ComboBoxItem Tag="主配角" Content="{DynamicResource Loc.CM.TypeSecondaryLead}"/>
                        <ComboBoxItem Tag="次配角" Content="{DynamicResource Loc.CM.TypeSupporting}"/>
                        <ComboBoxItem Tag="反派" Content="{DynamicResource Loc.CM.TypeAntagonist}"/>
                        <ComboBoxItem Tag="路人" Content="{DynamicResource Loc.CM.TypeExtra}"/>
                    </ComboBox>
                    
                    <TextBox x:Name="SearchTextBox"
                           materialDesign:HintAssist.Hint="{DynamicResource Loc.CM.SearchHint}"
                           materialDesign:TextFieldAssist.HasLeadingIcon="True"
                           materialDesign:TextFieldAssist.LeadingIcon="Search"
                           Width="200"
                           TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- 主内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：角色列表 -->
            <materialDesign:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Grid.Row="0" 
                          Background="{DynamicResource MaterialDesignDivider}" 
                          Padding="16,12">
                        <TextBlock Text="{DynamicResource Loc.CM.List}" FontWeight="Medium"/>
                    </Border>

                    <!-- 角色列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CharacterListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                          BorderThickness="0,0,0,1" 
                                          Padding="16,12"
                                          Background="Transparent"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 角色头像/图标 -->
                                            <Border Grid.Column="0" 
                                                  Background="{DynamicResource PrimaryHueLightBrush}"
                                                  CornerRadius="20"
                                                  Width="40" Height="40"
                                                  Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="Account" 
                                                                       Width="24" Height="24"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="White"/>
                                            </Border>

                                            <!-- 角色信息 -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         FontSize="14"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <materialDesign:Chip Content="{Binding Type, Converter={StaticResource StoredValueConverter}}" 
                                                                       FontSize="10"
                                                                       Height="20"
                                                                       Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Faction}" 
                                                             FontSize="12"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 状态指示 -->
                                            <materialDesign:PackIcon Grid.Column="2" 
                                                                   Kind="ChevronRight"
                                                                   Width="16" Height="16"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- 右侧：角色详细信息 -->
            <Grid Grid.Column="2" x:Name="DetailArea">
                <!-- 默认显示角色统计信息 -->
                <materialDesign:Card Padding="24" x:Name="DefaultCard">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.CM.Stats}" 
                                 FontSize="24" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,24"/>

                        <!-- 统计卡片 -->
                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <materialDesign:Card Margin="0,0,8,8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CM.TotalCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock x:Name="TotalCharactersTextBlock"
                                             Text="0" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="8,0,0,8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CM.MajorCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock x:Name="MainCharactersTextBlock"
                                             Text="0" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="0,8,8,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CM.FactionCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock x:Name="FactionCountTextBlock"
                                             Text="0" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="8,8,0,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CM.RelationCount}" 
                                             FontSize="14" 
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock x:Name="RelationshipCountTextBlock"
                                             Text="0" 
                                             FontSize="32" 
                                             FontWeight="Bold"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </UniformGrid>

                        <!-- 角色类型分布 -->
                        <TextBlock Text="{DynamicResource Loc.CM.TypeDistribution}" 
                                 FontSize="18" 
                                 FontWeight="Medium" 
                                 Margin="0,0,0,16"/>

                        <ItemsControl>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Chip Grid.Column="0" Content="{DynamicResource Loc.CM.TypeProtagonist}" Margin="0,0,12,0"/>
                                <ProgressBar x:Name="ProtagonistProgressBar" Grid.Column="1" Value="0" Maximum="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProtagonistCountTextBlock" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Chip Grid.Column="0" Content="{DynamicResource Loc.CM.TypeSecondaryLead}" Margin="0,0,12,0"/>
                                <ProgressBar x:Name="SupportingLeadProgressBar" Grid.Column="1" Value="0" Maximum="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SupportingLeadCountTextBlock" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Chip Grid.Column="0" Content="{DynamicResource Loc.CM.TypeAntagonist}" Margin="0,0,12,0"/>
                                <ProgressBar x:Name="AntagonistProgressBar" Grid.Column="1" Value="0" Maximum="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AntagonistCountTextBlock" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 角色详细信息界面 -->
                <materialDesign:Card Padding="24" x:Name="CharacterDetailCard" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 角色基本信息 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 角色头像 -->
                                <Border Grid.Column="0"
                                      Background="{DynamicResource PrimaryHueLightBrush}"
                                      CornerRadius="40"
                                      Width="80" Height="80"
                                      Margin="0,0,24,0">
                                    <materialDesign:PackIcon Kind="Account"
                                                           Width="48" Height="48"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"/>
                                </Border>

                                <!-- 角色基本信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CharacterNameText"
                                             Text="{DynamicResource Loc.CM.NamePlaceholder}"
                                             FontSize="28"
                                             FontWeight="Bold"
                                             Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <materialDesign:Chip x:Name="CharacterTypeChip"
                                                           Content="{DynamicResource Loc.CM.TypeProtagonist}"
                                                           Margin="0,0,8,0"/>
                                        <materialDesign:Chip x:Name="CharacterFactionChip"
                                                           Content="{DynamicResource Loc.CM.FactionPlaceholder}"
                                                           Background="{DynamicResource SecondaryHueLightBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CharacterCultivationText"
                                             Text="{DynamicResource Loc.CM.RealmPlaceholder}"
                                             FontSize="14"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                          Margin="0,0,0,8"
                                          Click="EditCharacter_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Edit" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Loc.Dlg.Edit}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                          Click="DeleteCharacter_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Loc.Dlg.Delete}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 角色描述 -->
                            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.CM.RemarksTitle}"
                                             FontSize="16"
                                             FontWeight="Medium"
                                             Margin="0,0,0,8"/>
                                    <TextBlock x:Name="CharacterDescriptionText"
                                             Text="{DynamicResource Loc.CM.RemarksHint}"
                                             TextWrapping="Wrap"
                                             LineHeight="20"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- 详细信息选项卡 -->
                            <materialDesign:Card Padding="0" Margin="0,0,0,16">
                                <TabControl Style="{StaticResource MaterialDesignTabControl}">
                                    <!-- 外貌特征 -->
                                    <TabItem Header="{DynamicResource Loc.CM.Appearance}">
                                        <Border Padding="16">
                                            <TextBlock x:Name="CharacterAppearanceText"
                                                     Text="{DynamicResource Loc.CM.AppearanceHint}"
                                                     TextWrapping="Wrap"
                                                     LineHeight="20"/>
                                        </Border>
                                    </TabItem>

                                    <!-- 性格特点 -->
                                    <TabItem Header="{DynamicResource Loc.CM.Personality}">
                                        <Border Padding="16">
                                            <TextBlock x:Name="CharacterPersonalityText"
                                                     Text="{DynamicResource Loc.CM.PersonalityHint}"
                                                     TextWrapping="Wrap"
                                                     LineHeight="20"/>
                                        </Border>
                                    </TabItem>

                                    <!-- 背景故事 -->
                                    <TabItem Header="{DynamicResource Loc.CM.Backstory}">
                                        <Border Padding="16">
                                            <TextBlock x:Name="CharacterBackgroundText"
                                                     Text="{DynamicResource Loc.CM.BackstoryHint}"
                                                     TextWrapping="Wrap"
                                                     LineHeight="20"/>
                                        </Border>
                                    </TabItem>

                                    <!-- 能力技能 -->
                                    <TabItem Header="{DynamicResource Loc.CM.Abilities}">
                                        <Border Padding="16">
                                            <TextBlock x:Name="CharacterAbilitiesText"
                                                     Text="{DynamicResource Loc.CM.AbilitiesHint}"
                                                     TextWrapping="Wrap"
                                                     LineHeight="20"/>
                                        </Border>
                                    </TabItem>

                                    <!-- 履历经历 -->
                                    <TabItem Header="{DynamicResource Loc.CM.Experience}">
                                        <Border Padding="16">
                                            <TextBlock x:Name="CharacterHistoryText"
                                                     Text="{DynamicResource Loc.CM.ExperienceHint}"
                                                     TextWrapping="Wrap"
                                                     LineHeight="20"/>
                                        </Border>
                                    </TabItem>

                                    <!-- 关键事件 -->
                                    <TabItem Header="{DynamicResource Loc.CM.KeyEvents}">
                                        <Border Padding="16">
                                            <TextBlock x:Name="CharacterKeyEventsText"
                                                     Text="{DynamicResource Loc.CM.KeyEventsHint}"
                                                     TextWrapping="Wrap"
                                                     LineHeight="20"/>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </materialDesign:Card>

                            <!-- 返回按钮 -->
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                  HorizontalAlignment="Left"
                                  Click="BackToOverview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc.CM.BackToOverview}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
