<Window x:Class="NovelManagement.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:NovelManagement.WPF.Views.Copilot"
        mc:Ignorable="d"
        Title="书籍管理系统 - 仪表盘" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏（颜色随主题皮肤可自定义） -->
        <materialDesign:ColorZone Grid.Row="0" 
                                  Mode="PrimaryMid" 
                                  Background="{DynamicResource AppTitleBarBackgroundBrush}"
                                  Foreground="{DynamicResource AppTitleBarForegroundBrush}"
                                  Padding="20,16">
            <DockPanel>
                <materialDesign:PackIcon Kind="Home"
                                       DockPanel.Dock="Left"
                                       Width="24" Height="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock Text="书籍管理系统 - 仪表盘" 
                             FontSize="20" 
                             FontWeight="Medium"/>
                    <TextBlock x:Name="CurrentLocationTextBlock"
                             Text="当前位置：仪表盘"
                             FontSize="12"
                             Opacity="0.9"/>
                </StackPanel>
                
                <!-- 右侧工具栏 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="返回上一页"
                            Click="Back_Click"
                            IsEnabled="False">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="CopilotToggleButton"
                            Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="AI 创作助手（对话式创作）"
                            Click="CopilotToggle_Click">
                        <materialDesign:PackIcon Kind="Robot" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="ThemeSettingsButton"
                            Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="主题配置与皮肤设定"
                            Click="ThemeSettings_Click">
                        <materialDesign:PackIcon Kind="Palette" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="AI模型配置与设置"
                            Click="AIConfiguration_Click">
                        <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="帮助"
                            Click="Help_Click">
                        <materialDesign:PackIcon Kind="Help" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="CopilotSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="CopilotColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏（颜色随主题皮肤可自定义） -->
            <materialDesign:ColorZone Grid.Column="0" 
                                      Mode="Light" 
                                      Background="{DynamicResource AppNavPanelBackgroundBrush}"
                                      Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <!-- 项目管理 -->
                        <Expander Header="项目管理"
                                Style="{StaticResource MaterialDesignExpander}"
                                IsExpanded="True"
                                Tag="固定组:项目管理"
                                Expanded="SidebarExpander_StateChanged"
                                Collapsed="SidebarExpander_StateChanged"
                                Margin="8">
                            <StackPanel Margin="16,8,0,8">
                                <Button Content="项目管理"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="ProjectManagement_Click"/>
                                <Button Content="新建项目"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="NewProject_Click"/>
                                <Button Content="导入项目"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="ImportProject_Click"/>

                                <!-- 项目列表（动态加载自数据库，新建书籍会自动出现在此处） -->
                                <ItemsControl x:Name="ProjectMenuItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding Name}"
                                                    Style="{StaticResource MaterialDesignExpander}"
                                                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                    Expanded="SidebarExpander_StateChanged"
                                                    Collapsed="SidebarExpander_StateChanged"
                                                    Margin="0,8,0,0"
                                                    ToolTip="{Binding Description}">
                                                <StackPanel Margin="16,8,0,8">
                                                    <Button Content="项目概览"
                                                          Style="{StaticResource MaterialDesignFlatButton}"
                                                          HorizontalAlignment="Left"
                                                          Tag="ProjectOverview"
                                                          Click="ProjectMenuItemNav_Click"/>

                                                    <!-- 设定管理子菜单 -->
                                                    <Expander Header="设定管理"
                                                            Style="{StaticResource MaterialDesignExpander}"
                                                            IsExpanded="{Binding SettingsGroupExpanded, Mode=TwoWay}"
                                                            Expanded="SidebarExpander_StateChanged"
                                                            Collapsed="SidebarExpander_StateChanged"
                                                            Margin="0,8,0,0">
                                                        <StackPanel Margin="16,8,0,8">
                                                            <Button Content="世界设定"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="WorldSettingManagement"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="修炼体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="CultivationSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="政治体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="PoliticalSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="职业体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="ProfessionSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="司法体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="JudicialSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="生民体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="PopulationSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="灵宝体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="TreasureSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="维度结构"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="DimensionStructure"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="地图结构"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="MapStructure"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="宠物体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="PetSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="装备体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="EquipmentSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="功法体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="TechniqueSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="商业体系"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="BusinessSystem"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="时间线"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="Timeline"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                        </StackPanel>
                                                    </Expander>

                                                    <Button Content="剧情管理"
                                                          Style="{StaticResource MaterialDesignFlatButton}"
                                                          HorizontalAlignment="Left"
                                                          Tag="PlotManagement"
                                                          Click="ProjectMenuItemNav_Click"/>

                                                    <!-- 人物管理子菜单 -->
                                                    <Expander Header="人物管理"
                                                            Style="{StaticResource MaterialDesignExpander}"
                                                            IsExpanded="{Binding PeopleGroupExpanded, Mode=TwoWay}"
                                                            Expanded="SidebarExpander_StateChanged"
                                                            Collapsed="SidebarExpander_StateChanged"
                                                            Margin="0,8,0,0">
                                                        <StackPanel Margin="16,8,0,8">
                                                            <Button Content="角色管理"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="ContentManagement"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                            <Button Content="关系网络"
                                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                                  HorizontalAlignment="Left"
                                                                  Tag="RelationshipNetwork"
                                                                  Click="ProjectMenuItemNav_Click"/>
                                                        </StackPanel>
                                                    </Expander>

                                                    <Button Content="势力管理"
                                                          Style="{StaticResource MaterialDesignFlatButton}"
                                                          HorizontalAlignment="Left"
                                                          Tag="FactionManagement"
                                                          Click="ProjectMenuItemNav_Click"/>
                                                    <Button Content="卷宗管理"
                                                          Style="{StaticResource MaterialDesignFlatButton}"
                                                          HorizontalAlignment="Left"
                                                          Tag="VolumeManagement"
                                                          Click="ProjectMenuItemNav_Click"/>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- AI助手 -->
                        <Expander Header="AI助手"
                                Style="{StaticResource MaterialDesignExpander}"
                                Tag="固定组:AI助手"
                                Expanded="SidebarExpander_StateChanged"
                                Collapsed="SidebarExpander_StateChanged"
                                Margin="8">
                            <StackPanel Margin="16,8,0,8">
                                <Button Content="一键生成书籍"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="OneClickGenerate_Click"
                                      ToolTip="由 RWKV 双 Agent 自动命名新书并生成大纲与第一章"/>
                                <Button Content="长篇批量生成"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="FullNovelBatchStart_Click"
                                      ToolTip="RWKV 官方创意参数 + 切片创作：3卷×30章×每章≥3000字，后台运行，支持断点续跑"/>
                                <Button Content="生成进度"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="FullNovelBatchStatus_Click"
                                      ToolTip="查看整本长篇批量生成任务的当前进度与评分"/>
                                <Button Content="前置条件生成"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="PrerequisiteGeneration_Click"
                                      ToolTip="为AI编辑功能生成必要的前置数据"/>
                                <Button Content="AI协作创作"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="AICollaboration_Click"/>
                                <Button Content="AI模型配置"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="AIConfiguration_Click"/>
                                <Button Content="对话生成器"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="DialogGeneration_Click"/>
                                <Button Content="内容生成"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="ContentGeneration_Click"/>
                                <Button Content="质量检查"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="QualityCheck_Click"/>
                                <Button Content="一致性检查"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      HorizontalAlignment="Left"
                                      Click="ConsistencyCheck_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 导入导出 -->
                        <Expander Header="导入导出"
                                Style="{StaticResource MaterialDesignExpander}"
                                Tag="固定组:导入导出"
                                Expanded="SidebarExpander_StateChanged"
                                Collapsed="SidebarExpander_StateChanged"
                                Margin="8">
                            <StackPanel Margin="16,8,0,8">
                                <Button Content="导出项目" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      HorizontalAlignment="Left"
                                      Click="ExportProject_Click"/>
                                <Button Content="发布管理" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      HorizontalAlignment="Left"
                                      Click="PublishManagement_Click"/>
                                <Button Content="统计报告" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      HorizontalAlignment="Left"
                                      Click="StatisticsReport_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:ColorZone>

            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- 右侧内容区域 -->
            <Grid Grid.Column="2" Margin="20" x:Name="MainContentArea">
                <!-- 仪表盘默认内容 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 欢迎区域 -->
                        <materialDesign:Card Margin="0,0,0,16" Padding="24">
                            <StackPanel>
                                <TextBlock Text="欢迎使用书籍管理系统" 
                                         FontSize="28" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,8"/>
                                <TextBlock Text="基于AI Agent协作的智能书籍创作平台" 
                                         FontSize="16" 
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         Margin="0,0,0,16"/>
                                
                                <!-- 快速操作 -->
                                <TextBlock Text="快速操作" 
                                         FontSize="18" 
                                         FontWeight="Medium" 
                                         Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,12,8"
                                            Click="NewProject_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                                            <TextBlock Text="新建项目"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,12,8"
                                            Click="ImportProject_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Import" Margin="0,0,8,0"/>
                                            <TextBlock Text="导入项目"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,12,8"
                                            Click="AICollaboration_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Robot" Margin="0,0,8,0"/>
                                            <TextBlock Text="AI协作"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 项目概览 -->
                        <materialDesign:Card Margin="0,0,0,16" Padding="24">
                            <StackPanel>
                                <TextBlock Text="项目概览"
                                         FontSize="20"
                                         FontWeight="Medium"
                                         Margin="0,0,0,16"/>

                                <!-- 项目卡片 -->
                                <materialDesign:Card Margin="0,0,0,12"
                                                   Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="DashboardProjectNameText" Text="未选择项目"
                                                     FontSize="16"
                                                     FontWeight="Medium"/>
                                            <TextBlock x:Name="DashboardProjectSubtitleText" Text=""
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     Margin="0,4,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:Chip Content="进行中"
                                                                   Background="{DynamicResource PrimaryHueMidBrush}"
                                                                   Foreground="White"
                                                                   Margin="0,0,8,0"/>
                                                <TextBlock Text="总字数: 125,000"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,16,0"/>
                                                <TextBlock Text="章节: 45"
                                                         VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                              Style="{StaticResource MaterialDesignFlatButton}"
                                              Content="打开项目"
                                              Click="ProjectOverview_Click"/>
                                    </Grid>
                                </materialDesign:Card>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 最近活动：显示最近相关项目的真实更新动态（章节/角色/项目变更） -->
                        <materialDesign:Card Padding="24">
                            <StackPanel>
                                <TextBlock Text="最近活动"
                                         FontSize="20"
                                         FontWeight="Medium"
                                         Margin="0,0,0,16"/>

                                <ItemsControl x:Name="RecentActivitiesControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding Message}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RelativeTime}"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         VerticalAlignment="Center"
                                                         Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="RecentActivityEmptyText"
                                         Text="暂无活动记录"
                                         FontStyle="Italic"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- AI 创作助手抽屉分隔条 -->
            <GridSplitter Grid.Column="3"
                          x:Name="CopilotSplitter"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- AI 创作助手抽屉（对话式创作流水线） -->
            <views:CopilotPanel Grid.Column="4"
                                x:Name="CopilotDrawer"
                                Visibility="Collapsed"/>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle" 
                                           Width="16" Height="16" 
                                           VerticalAlignment="Center"
                                           Foreground="Green"
                                           Margin="0,0,4,0"/>
                    <TextBlock Text="就绪"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CurrentProjectStatusText" Text="当前项目: 未选择"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="版本 1.0.0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusBarTimeText"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
