<Window x:Class="NovelManagement.WPF.Views.BatchGenerationOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="长篇批量生成选项"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <StackPanel Margin="24,20,24,20">

        <TextBlock Text="批量生成任务选项"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="未完成的任务会自动从断点续跑；新选项仅影响后续章节与新卷。"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <CheckBox x:Name="ChkUnlimited"
                  Content="无限续写模式（不设卷数上限，持续写新卷，直到手动取消）"
                  Margin="0,4,0,4"/>
        <CheckBox x:Name="ChkQuickSwitch"
                  Content="快速切卷：当前卷再写 3 章即开始下一分卷（用于验证跨卷衔接）"
                  Margin="0,4,0,10"/>

        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="每卷章节数：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtChaptersPerVolume" Grid.Column="1" Text="30" Padding="6,4"/>
            <TextBlock Grid.Column="2" Text="（默认 30，范围 3–100）"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
        </Grid>

        <Grid Margin="0,4,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="每章目标字数：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtChapterTargetWords" Grid.Column="1" Text="3000" Padding="6,4"/>
            <TextBlock Grid.Column="2" Text="（默认 3000，范围 800–10000）"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Width="88"/>
            <Button Content="开始生成"
                    Click="Start_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="110"
                    Margin="12,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
