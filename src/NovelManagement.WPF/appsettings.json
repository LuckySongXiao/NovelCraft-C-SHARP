{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=NovelManagement.db"
  },
  "Application": {
    "Name": "小说管理系统",
    "Version": "1.0.0",
    "Environment": "Production"
  },
  "Diagnostics": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true
  },
  "Backup": {
    "RetentionDays": 14,
    "EnableCleanupOnStartup": true
  },
  "Startup": {
    "SeedSampleDataOnStartup": false,
    "BackupBeforeMigration": true
  },
  "AI": {
    "DefaultProvider": "Ollama",
    "DefaultCompletionProvider": "RWKV",
    "AgentRoles": {
      "EnableDualAgentWorkflow": true,
      "EnableArchiveWrite": true,
      "MainAgentProvider": "DeepSeek",
      "MainAgentModel": "",
      "MainAgentRoleDescription": "结合 SubAgent 的需求简报撰写正式文案，专注内容创作。",
      "SubAgentProvider": "LlamaCpp",
      "SubAgentModel": "",
      "SubAgentRoleDescription": "总结写作需求，整理 MainAgent 草稿，并将纯净内容写入项目档案库。"
    },
    "Providers": {
      "RWKV": {
        "BaseUrl": "http://localhost:8000",
        "ModelPath": "",
        "ModelName": "rwkv7",
        "Strategy": "cuda fp16",
        "VocabPath": "",
        "Password": "",
        "MaxTokensPerCompletion": 200,
        "Temperature": 1.0,
        "TopP": 0.7,
        "TopK": 50,
        "FrequencyPenalty": 0.0,
        "PresencePenalty": 0.0,
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "AutoStartServer": false,
        "PythonPath": "python",
        "ServerScriptPath": "",
        "GpuDeviceId": -1
      },
      "LlamaCpp": {
        "ProviderKind": "LlamaCpp",
        "BaseUrl": "http://localhost:8081",
        "ExecutablePath": "",
        "Backend": "cuda",
        "ModelDirectory": "",
        "ModelPath": "",
        "DefaultModel": "local-gguf",
        "MmprojPath": "",
        "ApiKey": "",
        "ContextSize": 262144,
        "GpuLayers": -1,
        "ParallelSlots": 1,
        "EnableFlashAttention": true,
        "CacheTypeK": "q8_0",
        "CacheTypeV": "q8_0",
        "EnableCpuMoE": true,
        "CpuMoELayerCount": 0,
        "EnableAutoFit": true,
        "FitContextSize": 262144,
        "DisableWarmup": true,
        "StartupTimeoutSeconds": 45
      },
      "ZhipuAI": {
        "ProviderKind": "ZhipuAI",
        "BaseUrl": "https://open.bigmodel.cn/api/paas/v4",
        "ApiKey": "",
        "DefaultModel": "glm-4.7-flash",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "DefaultTemperature": 0.7,
        "DefaultMaxTokens": 4000,
        "EnableStreaming": true
      },
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "qwq:latest",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "EnableGPU": true,
        "GPUDeviceId": -1,
        "MaxConcurrentRequests": 3,
        "EnableModelPreload": true,
        "ModelKeepAliveMinutes": 30,
        "EnableVerboseLogging": false
      },
      "OpenAI": {
        "ProviderKind": "Custom",
        "ApiKey": "",
        "BaseUrl": "https://api.openai.com/v1",
        "DefaultModel": "gpt-3.5-turbo",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "DefaultTemperature": 0.7,
        "DefaultMaxTokens": 4000,
        "EnableStreaming": true
      },
      "DeepSeek": {
        "ProviderKind": "DeepSeek",
        "ApiKey": "",
        "BaseUrl": "https://api.deepseek.com",
        "DefaultModel": "deepseek-v4-flash",
        "Model": "deepseek-v4-flash",
        "TimeoutSeconds": 60,
        "MaxRetries": 3,
        "EnableThinkingChain": true,
        "ThinkingChainDelay": 100,
        "DefaultTemperature": 0.7,
        "DefaultMaxTokens": 4000,
        "EnableStreaming": true
      },
      "XiaoMiMiMo": {
        "ProviderKind": "XiaoMiMiMo",
        "BaseUrl": "https://api.xiaomimimo.com/v1",
        "ApiKey": "",
        "DefaultModel": "mimo-v2.5-pro",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "DefaultTemperature": 1.0,
        "DefaultMaxTokens": 8192,
        "EnableStreaming": true
      },
      "MCP": {
        "ServerUrl": "ws://localhost:8080",
        "ConnectionType": "WebSocket",
        "AuthenticationType": "None",
        "ConnectionTimeoutSeconds": 30,
        "RequestTimeoutSeconds": 60,
        "MaxRetries": 3,
        "EnableHeartbeat": true,
        "HeartbeatIntervalSeconds": 30,
        "EnableCompression": true,
        "MaxMessageSize": 1048576,
        "EnableVerboseLogging": false
      }
    }
  },
  "Features": {
    "EnableAI": true,
    "EnableAutoSave": true,
    "AutoSaveInterval": 300
  }
}
