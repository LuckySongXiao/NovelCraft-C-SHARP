{
  "Application": {
    "Environment": "Production"
  },
  "Diagnostics": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true
  },
  "Backup": {
    "RetentionDays": 30,
    "EnableCleanupOnStartup": true
  },
  "Startup": {
    "SeedSampleDataOnStartup": false,
    "BackupBeforeMigration": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=NovelManagement.db"
  },
  "AI": {
    "DefaultProvider": "Ollama",
    "Providers": {
      "ZhipuAI": {
        "ApiKey": "replace-with-real-key"
      },
      "OpenAI": {
        "ApiKey": "replace-with-real-key"
      },
      "DeepSeek": {
        "ApiKey": "replace-with-real-key"
      }
    }
  }
}
